{
  "name": "kaname",
  "private": true,
  "version": "0.1.0",
  "description": "Kaname（要）— 仕様（01〜10）と実装（apps/・packages/）を同じリポジトリで持ち、CI が両方のゲートを回す",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,mjs,json,yml,yaml,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,yml,yaml,md}\"",
    "type-check": "tsc -b tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "ci:ac-validate": "bash 09_dispatch/scripts/validate.sh",
    "ci:layer-audit": "python3 scripts/ci/layer_audit.py --run",
    "ci:rls-enabled": "tsx packages/db/src/cli.ts rls-enabled",
    "ci:no-vendor-sql": "tsx packages/db/src/cli.ts no-vendor-sql",
    "ci:context-set": "node scripts/ci/context_set.mjs",
    "ci:boundary": "node scripts/ci/gate_pending.mjs G7 T-F-05",
    "ci:license-boundary": "node scripts/ci/gate_pending.mjs G8 T-F-05",
    "ci:ledger-sync": "node scripts/ci/gate_pending.mjs G9 T-F-05",
    "ci:no-sql-concat": "node scripts/ci/sql_guard.mjs --no-sql-concat",
    "ci:openapi-diff": "node scripts/ci/contract.mjs check",
    "ci:migration-integration": "tsx packages/db/src/cli.ts fresh-migrate",
    "ci:env-audit": "node scripts/ci/env_audit.mjs",
    "ci:choke": "node scripts/ci/choke.mjs",
    "ci:no-dynamic-call": "node scripts/ci/choke.mjs --no-dynamic",
    "ci:choke-exceptions": "node scripts/ci/choke.mjs --exceptions",
    "ci:task-choke-declared": "node scripts/ci/gate_pending.mjs G26 T-F-09",
    "ci:access-matrix": "tsx packages/db/src/cli.ts access-matrix",
    "ci:ears-mapping": "node scripts/ci/ears_mapping.mjs",
    "ci:resource-static": "node scripts/ci/sql_guard.mjs --resource-static",
    "ci:schemathesis": "node scripts/ci/gate_pending.mjs G36 T-F-15",
    "db:migrate": "tsx packages/db/src/cli.ts migrate && tsx packages/auth/src/cli.ts",
    "ci:choke:all": "node scripts/ci/choke.mjs --all",
    "ci:choke:selftest": "node scripts/ci/choke.test.mjs",
    "ci:sql-guard:selftest": "node scripts/ci/sql_guard.test.mjs",
    "ci:contract:gen": "node scripts/ci/contract.mjs gen",
    "ci:endpoints": "node scripts/ci/contract.mjs endpoints",
    "ci:errors-used": "node scripts/ci/errors_used.mjs",
    "ci:errors:gen": "node scripts/ci/errors_used.mjs gen",
    "provision:bucket": "tsx infra/provision/bucket.ts",
    "ci:contract:selftest": "node scripts/ci/contract.test.mjs",
    "ci:env-audit:selftest": "node scripts/ci/env_audit.test.mjs",
    "ci:errors-used:selftest": "node scripts/ci/errors_used.test.mjs",
    "ci:ears:gen": "node scripts/ci/gen_ears_tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
