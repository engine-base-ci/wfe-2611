-        except Exception:
-            _emit("p", "dagci-trace-error")
-
-    sys.addaudithook(_hook)
-
-    # 有無だけを見る呼び出し（os.path.exists など）は監査の事象を出さないので、os.stat などを包む
-    def _wrap(fn):
