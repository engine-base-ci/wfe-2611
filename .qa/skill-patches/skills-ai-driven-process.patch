-def glob_re(pat: str) -> re.Pattern:
-    """** は 0 個以上のフォルダ、* は / を越えない、? は 1 文字。/ で終われば その下全部"""
-    if pat in _cache:
-        return _cache[pat]
-    p = pat[2:] if pat.startswith("./") else pat
-    if p.endswith("/"):
-        p += "**"
-    i, out = 0, ""
-    while i < len(p):
-        if p.startswith("**/", i):
-            out += r"(?:.*/)?"
-            i += 3
-        elif p.startswith("**", i):
-            out += r".*"
-            i += 2
-        elif p[i] == "*":
-            out += r"[^/]*"
-            i += 1
-        elif p[i] == "?":
-            out += r"[^/]"
-            i += 1
-        else:
-            out += re.escape(p[i])
-            i += 1
-    _cache[pat] = re.compile(out + r"\Z")
-    return _cache[pat]
