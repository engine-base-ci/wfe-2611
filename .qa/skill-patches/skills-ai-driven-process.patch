-#   ・GitHub の hosted runner（分単位の料金・月の上限）は使わない。runs-on は self-hosted のラベルだけ
-#   ・ブランチの push → 毎回全部の段（user の決定 2026-10-28。待ちは queue で見える。メンバーは dagci await で結果だけ受け取る）
-#   ・ci/merge/* は pm_merge.sh が取り込みの直前に置く版（同じく全部）
-#   ・main には流さない（main に入るのは緑を確かめた版だけ。main に入った後は dagci-deploy.yml が反映する）
-#   ・job の名前 verify が check の名前になる（ci.yaml の ci.check と同じにする。deploy はこの緑を確かめる）
-name: dagci
-on:
-  push:
-    branches-ignore: [main]
-  workflow_dispatch:
-concurrency:
-  group: dagci-${{ github.ref }}
-  cancel-in-progress: true
-jobs:
-  verify:
-    runs-on: [self-hosted, dagci]
-    timeout-minutes: 180
-    steps:
-      - uses: actions/checkout@v4
-        with: {fetch-depth: 0}
-      - name: dagci（全部の段）
-        env:
-          REF_NAME: ${{ github.ref_name }}
-        run: |
-          git fetch -q origin main:refs/remotes/origin/main || true
-          DAGCI_BRANCH="$REF_NAME" "${DAGCI:?runner の .env に DAGCI が無い}" run --base origin/main --summary
