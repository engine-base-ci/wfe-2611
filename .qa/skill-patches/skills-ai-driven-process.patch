+def choose_workflows(root: str) -> tuple[list[str], list[str]]:
+    """検査の workflow を選ぶ（push の枝・pull_request・手で押す）。リリース・タグだけ・予定だけのものは外す"""
+    keep, drop = [], []
+    for p in sorted(glob.glob(os.path.join(root, ".github", "workflows", "*.y*ml"))):
+        rel = os.path.relpath(p, root)
+        try:
+            on = sg.load_yaml(p).get("on")
+        except yaml.YAMLError as ex:
+            drop.append(f"{rel}（読めない: {ex}）")
+            continue
+        ev = {on: None} if isinstance(on, str) else ({e: None for e in on} if isinstance(on, list) else (on or {}))
+        push = ev.get("push") if isinstance(ev.get("push"), dict) else {}
+        tags_only = "push" in ev and push and ("tags" in push and "branches" not in push)
+        if "release" in ev or "deployment" in ev:
+            drop.append(f"{rel}（リリース・反映の workflow）")
+        elif any(e in ev for e in ("pull_request", "pull_request_target", "merge_group")) or ("push" in ev and not tags_only):
+            keep.append(rel)
+        elif "workflow_dispatch" in ev and not tags_only:
+            keep.append(rel)
+        else:
+            drop.append(f"{rel}（検査の出来事で動かない: {sorted(ev)}）")
+    return keep, drop
+
