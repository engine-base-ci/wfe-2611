-#!/usr/bin/env python3
-"""作業場の中のパスの指紋を出す（dagci が「前に読んだものが今も同じか」を見るのに使う）。
-
-  入力 JSON: {"reads": [...], "stats": [...], "dirs": [...]}（作業場からの相対パス）
-  出力 JSON: 同じ形で、各パスの指紋
-    reads: 中身の sha256（無ければ "-"・フォルダなら "dir"）
-    stats: "f"（ファイル）・"d"（フォルダ）・"l"（リンク）・"-"（無い）
-    dirs:  中の名前を並べたものの sha256（無ければ "-"）
-"""
-import hashlib
-import json
-import os
-import sys
-
-req = json.load(open(sys.argv[1], encoding="utf-8"))
-
-
-def content(p):
-    if os.path.isdir(p):
-        return "dir"
-    try:
-        h = hashlib.sha256()
-        with open(p, "rb") as f:
-            for chunk in iter(lambda: f.read(1 << 20), b""):
-                h.update(chunk)
-        return h.hexdigest()
-    except OSError:
-        return "-"
-
-
-def kind(p):
-    if os.path.islink(p):
-        return "l"
-    if os.path.isdir(p):
-        return "d"
-    return "f" if os.path.exists(p) else "-"
-
-
-def listing(p):
-    try:
-        return hashlib.sha256("\0".join(sorted(os.listdir(p))).encode("utf-8", "surrogateescape")).hexdigest()
-    except OSError:
-        return "-"
-
-
-res = {"reads": {p: content(p) for p in req.get("reads", [])},
-       "stats": {p: kind(p) for p in req.get("stats", [])},
-       "dirs": {p: listing(p) for p in req.get("dirs", [])}}
-json.dump(res, open(sys.argv[2], "w", encoding="utf-8"), ensure_ascii=False)
