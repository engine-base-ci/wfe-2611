+#!/usr/bin/env python3
+"""テストが開発者の台を決め打ちしていないか（標準の検査・あるプロジェクトの 2026-11-04 の赤から作った）。設定は ci-gates.yaml の devhost:。
+
+  python3 <skill>/scripts/gates/devhost_gate.py [--root <根>] [--config <ci-gates.yaml>]
+  python3 <skill>/scripts/gates/devhost_gate.py --selftest    一時のリポジトリで、決め打ちの接続先・口だけの書き換えを赤にできるか
+
+テストのファイルとテストの手伝いのファイル（tests の glob）を読み、次を「ファイル:行」で赤にする:
+  H1 環境の値が無いときに、決まった手元の接続先へ落ちる
+       process.env.DATABASE_URL ?? "postgres://...@127.0.0.1:55433/..."・|| 'localhost:5432'・os.environ.get("X", "redis://localhost:6379")・
+       os.getenv("X") or "..."・${X:-localhost:5432}・ENV.fetch("X", "...")
+     （CI では環境の値が無い・違う所を見て、偽の緑か、どこかの開発者の DB に繋がる。値が無ければ止める：throw・KeyError・${X:?}）
+  H2 環境から来た URL の口（port）だけを書き換える（ホストは環境のまま。CI の相手は 127.0.0.1 ではないので、別の口に繋がらない）
+       u.port = "5433"・url.replace(/:\\d+\\//, ":5434/")・.replace(":5432", ...)・_replace(netloc=...)・re.sub(r":\\d+", ...)
+  H3 テストの中の決め打ちの DB・相手の URL（postgres・mysql・redis・mongodb・amqp の localhost・127.0.0.1）を、環境から読まずに使う
+  H4 例外の記録（allow）に理由が無い・もう何にも当たらない（記録から外す）
+由来：あるプロジェクトの CI の赤（2026-11-04）。テストが process.env.DATABASE_URL ?? "postgres://…127.0.0.1:55433/…"（開発者の台の DB）に落ち、
+  別のテストは 127.0.0.1 でない URL の口だけを替えていた。どちらも手元では緑、容れ物の CI でだけ赤。
+
+設定（ci-gates.yaml）:
+  devhost:
+    tests: ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/__tests__/**", "**/test_*.py", "**/*_test.py",
+            "**/conftest.py", "**/vitest.config.*", "**/jest.config.*", "**/playwright.config.*", "**/test-utils/**", "**/testing/**"]
+    exclude: ["**/node_modules/**", "**/dist/**", "**/build/**"]
+    allow_file: ci/devhost_allow.yaml   # [{path: glob, contains: 行の一部, why: 理由}]。理由の無いもの・当たらないものは赤（H4）
+"""
+from __future__ import annotations
+
+import fnmatch
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from _common import config, not_used, root_from_args  # noqa: E402
+
+TESTS = ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/__tests__/**", "**/test_*.py", "**/*_test.py",
+         "**/*_test.go", "**/conftest.py", "**/vitest.config.*", "**/vitest.setup.*", "**/jest.config.*", "**/jest.setup.*",
+         "**/playwright.config.*", "**/test-utils/**", "**/testing/**", "**/test-helpers/**", "**/spec/**"]
+EXCLUDE = ["**/node_modules/**", "**/dist/**", "**/build/**", "**/.next/**", "**/coverage/**", "**/vendor/**", ".git/**"]
+CODE = (".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs", ".py", ".sh", ".bash", ".rb", ".go", ".env", ".yml", ".yaml", ".json")
+
+HOST = r"(?:localhost|127\.\d+\.\d+\.\d+|0\.0\.0\.0|\[::1\]|host\.docker\.internal)"
+SVC_PORT = r"(?:5432|543\d\d|3306|33060|6379|27017|5672|9200|11211|1433|1521|9092|8123|4566|9000|55\d\d\d)"
+# 手元を指す文字列：手元の名前を含む・口つきの URL・よく使う相手の口
+LOCAL_LIT = rf"""(?P<q>["'`])(?P<lit>[^"'`\n]*(?:{HOST}|://[^"'`\n/]*:\d{{2,5}}|(?<![\w.]){SVC_PORT}\b)[^"'`\n]*)(?P=q)"""
+ENV_READ = (r"(?:process\.env(?:\.[A-Za-z_]\w*|\[\s*[\"'][^\"']+[\"']\s*\])!?|import\.meta\.env\.[A-Za-z_]\w*|"
+            r"Deno\.env\.get\([^)]*\)|Bun\.env\.[A-Za-z_]\w*|os\.environ\.get\([^,)]*\)|os\.getenv\([^,)]*\)|ENV\[[^\]]+\])")
+H1 = [
+    re.compile(rf"{ENV_READ}\s*(?:\?\?|\|\||\bor\b)\s*{LOCAL_LIT}", re.S),
+    re.compile(rf"(?:os\.environ\.get|os\.getenv|ENV\.fetch)\(\s*[^,()]+,\s*{LOCAL_LIT}", re.S),
+]
+# H1 の shell の形は、引用符なしの ${X:-localhost:5432} も拾う
+H1_SH = re.compile(rf"\$\{{[A-Za-z_]\w*:?-[^}}]*(?:{HOST}|:{SVC_PORT}\b)[^}}]*\}}")
+H2 = [
+    re.compile(r"\.port\s*=(?!=)\s*[^;\n]+"),
+    re.compile(r"\.replace\(\s*(?:/(?:[^/\n\\]|\\.)*:\\d(?:[^/\n\\]|\\.)*/[gimsuy]*|[\"'`]:\d{2,5}/?[\"'`])\s*,"),   # 口だけ（":5432"）か、:\d を含む正規表現
+    re.compile(r"_replace\(\s*(?:netloc|port)\s*="),
+    re.compile(r"re\.sub\(\s*r?[\"'][^\"'\n]*:\\d\+?[^\"'\n]*[\"']"),
+]
+H2_HOST_TOO = re.compile(r"\.(?:hostname|host)\s*=(?!=)")
+H3 = re.compile(rf"""["'`](?:postgres(?:ql)?|mysql|mariadb|redis|rediss|mongodb(?:\+srv)?|amqp)://[^"'`\n]*{HOST}[^"'`\n]*["'`]""")
+
+
+def line_of(text: str, pos: int) -> int:
+    return text.count("\n", 0, pos) + 1
+
+
+def glob_match(path: str, pats: list[str]) -> bool:
+    for p in pats:
+        if fnmatch.fnmatch(path, p) or (p.startswith("**/") and fnmatch.fnmatch(path, p[3:])):
+            return True
+    return False
+
+
+class Gate:
+    def __init__(self, root: str, cfg: dict):
+        self.root, self.cfg = root, cfg
+        self.allow: list[dict] = []
+        af = cfg.get("allow_file")
+        if af and os.path.exists(os.path.join(root, af)):
+            import yaml
+            self.allow = yaml.safe_load(open(os.path.join(root, af), encoding="utf-8")) or []
+        self.allow += list(cfg.get("allow") or [])
+        self.used: set[int] = set()
+
+    def files(self) -> list[str]:
+        r = subprocess.run(["git", "ls-files", "-z", "-co", "--exclude-standard"], cwd=self.root, capture_output=True, text=True)
+        if r.returncode == 0:
+            fs = [f for f in r.stdout.split("\0") if f]
+        else:
+            fs = []
+            for d, dirs, names in os.walk(self.root):
+                dirs[:] = [x for x in dirs if x not in ("node_modules", ".git")]
+                fs += [os.path.relpath(os.path.join(d, n), self.root) for n in names]
+        tests, ex = self.cfg.get("tests") or TESTS, EXCLUDE + list(self.cfg.get("exclude") or [])
+        return sorted(f for f in fs if f.endswith(CODE) and glob_match(f, tests) and not glob_match(f, ex)
+                      and os.path.isfile(os.path.join(self.root, f)))
+
+    def allowed(self, path: str, text: str) -> bool:
+        for i, a in enumerate(self.allow):
+            if glob_match(path, [str(a.get("path", "**"))]) and str(a.get("contains", "")) in text:
+                self.used.add(i)
+                return True
+        return False
+
+    def check(self) -> list[str]:
+        fails: list[str] = []
+        for f in self.files():
+            try:
+                text = open(os.path.join(self.root, f), encoding="utf-8").read()
+            except (UnicodeDecodeError, OSError):
+                continue
+            lines = text.splitlines()
+            seen: set[int] = set()
+
+            def hit(code: str, pos: int, why: str):
+                ln = line_of(text, pos)
+                src = lines[ln - 1].strip() if ln - 1 < len(lines) else ""
+                if (code, ln) in seen or self.allowed(f, src):
+                    return
+                seen.add((code, ln))
+                fails.append(f"{code} {f}:{ln} {why}：{src[:120]}")
+            for rx in H1:
+                for m in rx.finditer(text):
+                    hit("H1", m.start(), "環境の値が無いと手元の決まった接続先に落ちる（無ければ止める）")
+            for m in H1_SH.finditer(text):
+                hit("H1", m.start(), "環境の値が無いと手元の決まった接続先に落ちる（${X:?} で止める）")
+            for rx in H2:
+                for m in rx.finditer(text):
+                    ln = line_of(text, m.start())
+                    near = "\n".join(lines[max(0, ln - 6):ln + 5])
+                    if rx is H2[0] and H2_HOST_TOO.search(near):
+                        continue   # ホストも一緒に決めている（口だけの書き換えではない）
+                    hit("H2", m.start(), "URL の口だけを書き換えている（ホストは環境のまま。相手ごと環境から受け取る）")
+            for m in H3.finditer(text):
+                ln = line_of(text, m.start())
+                if any(c == "H1" and l == ln for c, l in seen):
+                    continue
+                hit("H3", m.start(), "決め打ちの手元の相手の URL（環境から読む）")
+        for i, a in enumerate(self.allow):
+            if not str(a.get("why", "")).strip():
+                fails.append(f"H4 例外の記録 {a.get('path')}「{a.get('contains', '')}」に理由（why）が無い")
+            elif i not in self.used:
+                fails.append(f"H4 例外の記録 {a.get('path')}「{a.get('contains', '')}」が、もう何にも当たらない（記録から外す）")
+        return fails
+
+
+def report(g: Gate) -> int:
+    fails = g.check()
+    for f in fails:
+        print("  ★", f)
+    print(f"テストのファイル {len(g.files())} 本・例外の記録 {len(g.allow)} 件")
+    print("FAIL — テストが開発者の台を決め打ちしている" if fails else "PASS — テストは接続先を環境から受け取る（理由つきの例外を除く）")
+    return 1 if fails else 0
+
+
+def selftest() -> int:
+    d = tempfile.mkdtemp(prefix="devhost-gate-selftest-")
+    try:
+        def w(p, s):
+            os.makedirs(os.path.dirname(os.path.join(d, p)) or d, exist_ok=True)
+            open(os.path.join(d, p), "w", encoding="utf-8").write(s)
+        w("apps/api/test/db.test.ts", 'const url = process.env.DATABASE_URL ?? "postgres://dev:dev@127.0.0.1:55433/app";\n')
+        w("apps/api/test/redis.test.ts", "const r = process.env['REDIS_URL'] ||\n  'localhost:6379';\n")
+        w("tests/conftest.py", 'import os\nURL = os.environ.get("DATABASE_URL", "postgresql://localhost:5432/x")\n')
+        w("tests/test_or.py", 'import os\nURL = os.getenv("DATABASE_URL") or "postgresql://u@127.0.0.1/x"\n')
+        w("tests/run.sh", 'psql "${DATABASE_URL:-postgres://localhost:5432/app}" -c "select 1"\n')
+        w("apps/api/test/port.test.ts", "const u = new URL(process.env.DATABASE_URL!);\nu.port = '5434';\nconnect(u.toString());\n")
+        w("apps/api/test/port2.test.ts", "const other = process.env.DATABASE_URL!.replace(/:\\d+\\//, ':5434/');\n"
+                                         "const b = process.env.X!.replace(':5432', ':5434');\n"
+                                         "const ok = u.replace('http://localhost:3001', 'http://localhost');\n")
+        w("tests/test_port.py", 'import os\nu = urlparse(os.environ["DATABASE_URL"])._replace(netloc="x:1")\n')
+        w("tests/test_lit.py", 'c = connect("postgres://postgres:pw@localhost:5432/app")\n')
+        # 緑のもの：値が無ければ止める・ホストも決める・テストでないファイル・相手の名前の URL
+        w("apps/api/test/ok.test.ts", 'const url = process.env.DATABASE_URL ?? (() => { throw new Error("DATABASE_URL が無い") })();\n'
+                                      "const u = new URL(url);\nu.hostname = 'db2';\nu.port = '5434';\n"
+                                      "const label = process.env.NAME ?? 'テスト';\n")
+        w("tests/test_ok.py", 'import os\nURL = os.environ["DATABASE_URL"]\nN = os.environ.get("N", "3")\n')
+        w("src/config.ts", 'export const url = process.env.DATABASE_URL ?? "postgres://127.0.0.1:5432/app";\n')
+        w("tests/allowed.test.ts", 'const local = process.env.MOCK_URL ?? "http://127.0.0.1:4010"; // 試験の中で立てる口\n')
+        subprocess.run(["git", "init", "-q"], cwd=d)
+        g = Gate(d, {})
+        fails = g.check()
+        want = {("H1", "apps/api/test/db.test.ts"), ("H1", "apps/api/test/redis.test.ts"), ("H1", "tests/conftest.py"),
+                ("H1", "tests/test_or.py"), ("H1", "tests/run.sh"), ("H2", "apps/api/test/port.test.ts"),
+                ("H2", "apps/api/test/port2.test.ts"), ("H2", "tests/test_port.py"), ("H3", "tests/test_lit.py"),
+                ("H1", "tests/allowed.test.ts")}
+        got = {(f.split()[0], f.split()[1].rsplit(":", 1)[0]) for f in fails}
+        found = want <= got
+        quiet = not any(x in f for f in fails for x in ("ok.test.ts", "test_ok.py", "src/config.ts"))
+        line_ok = any(f.startswith("H1 apps/api/test/redis.test.ts:1 ") for f in fails)
