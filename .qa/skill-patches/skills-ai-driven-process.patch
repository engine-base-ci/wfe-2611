+"""dagci init-ci — プロジェクトの GitHub の workflow と package.json などから、ci.yaml の下書きを作る。
+
+  dagci init-ci [--root <根>] [--workflow <パス> ...] [--out <書く先>] [--force] [--offline]
+
+読むもの:
+  workflow   actions/setup-node の node-version（node-version-file）・pnpm/action-setup の version・actions/setup-python の
+             python-version・pip install の部品・apt-get install の部品・playwright install・services（image・env・ports）
+  ファイル   package.json（packageManager・engines・workspaces）・pnpm-workspace.yaml・lockfile・.nvmrc・.node-version・.python-version
+書くもの（ci.yaml。すでにあれば ci.init.yaml に書き、上書きしない。--force で上書き）:
+  toolbox    元の image（Node があれば node の公式・無ければ python の公式）と、版を固定した道具（GitHub の実行機と同じ版）
+             証明書の環境（NODE_EXTRA_CA_CERTS・SSL_CERT_FILE・REQUESTS_CA_BUNDLE・UV_NATIVE_TLS）と PATH・venv の決まりを既定で入れる
+  prepare    依存の部品（lockfile が同じなら使い回す）・playwright のブラウザ
+  services   job ごとの相手（<job>-<名前>）
+  include    段は workflow から毎回導く（dagci stages・手で写さない）
+  github     段の導き方の設定（外す job は理由つき）
+  smoke      dagci smoke が流す、プロジェクトの短い確かめ（空で書く）
+版の決め方: workflow に「22」としか書いていなければ、その時点の 22 の最新（nodejs.org の一覧）に固定する。網が無ければ（--offline）
+  書いてあるまま（node:22-bookworm）にする。Python の部品は版が書いていなければ PyPI の最新に固定する（下書きの注に出す）。
+"""
+from __future__ import annotations
+
+import glob
+import json
+import os
+import re
+import shlex
+import ssl
+import sys
+import urllib.request
+
+import yaml
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import stages_from_github as sg  # noqa: E402
+
+UV_VERSION = "0.9.5"
+CERT = "/etc/ssl/certs/ca-certificates.crt"
+PG_IMAGE = re.compile(r"postgres|pgvector|postgis|timescale", re.I)
+
+
+def _get_json(url: str, offline: bool):
+    if offline:
+        return None
+    ctx = ssl.create_default_context()
+    for ca in (os.environ.get("SSL_CERT_FILE"), os.environ.get("DAGCI_EXTRA_CA"), CERT):
+        if ca and os.path.exists(ca):
+            try:
+                ctx.load_verify_locations(ca)
+            except ssl.SSLError:
+                pass
+    try:
+        with urllib.request.urlopen(url, timeout=20, context=ctx) as r:
+            return json.load(r)
+    except Exception:   # 網が無い・遅い → 書いてあるままにする
+        return None
+
+
+def exact_node(spec: str, offline: bool) -> str:
+    """'22'・'22.x'・'>=22'・'lts/*' → その時点の最新の 22.x.y（分からなければ書いてあるまま）"""
+    s = spec.strip().lstrip("v")
+    if re.fullmatch(r"\d+\.\d+\.\d+", s):
+        return s
+    idx = _get_json("https://nodejs.org/dist/index.json", offline)
+    m = re.search(r"\d+", s)
+    if idx:
+        for e in idx:   # 新しい順
+            v = e["version"].lstrip("v")
+            if s.startswith("lts") and e.get("lts"):
+                return v
+            if m and v.split(".")[0] == m.group(0) and (not re.fullmatch(r"\d+\.\d+(\.x)?", s) or v.startswith(s.replace(".x", "") + ".")):
+                return v
+    return m.group(0) if m else "22"
+
+
+def pin_pypi(req: str, offline: bool) -> tuple[str, bool]:
+    """版の無い部品を PyPI の最新に固定する（固定したら True）"""
+    if re.search(r"[=<>~!@]", req) or req.startswith((".", "/", "git+", "http")):
+        return req, False
+    name = re.sub(r"\[.*\]$", "", req)
+    d = _get_json(f"https://pypi.org/pypi/{name}/json", offline)
+    if d and d.get("info", {}).get("version"):
+        return f"{req}=={d['info']['version']}", True
+    return req, False
+
+
+def read(root: str, rel: str) -> str:
+    p = os.path.join(root, rel)
+    return open(p, encoding="utf-8").read().strip() if os.path.exists(p) else ""
+
+
+class Facts:
+    def __init__(self):
+        self.node: list[str] = []
+        self.pnpm: list[str] = []
+        self.python: list[str] = []
+        self.pip: list[str] = []
+        self.pip_req_files: list[str] = []
+        self.apt: list[str] = []
+        self.playwright: list[str] = []
+        self.chrome = False
+        self.notes: list[str] = []
+
+
+def scan(root: str, wfs: list[str], g: dict) -> Facts:
+    f = Facts()
+    skip_jobs = set(g.get("skip_jobs") or {})
+    for wf in wfs:
+        w = sg.load_yaml(os.path.join(root, wf))
+        wenv = {k: str(v) for k, v in (w.get("env") or {}).items()}
+        for job, j in (w.get("jobs") or {}).items():
+            if not isinstance(j, dict) or job in skip_jobs:
+                continue
+            ctx = {"env": {**wenv, **{k: str(v) for k, v in (j.get("env") or {}).items()}}, "matrix": sg.first_matrix(j)}
+            for st in j.get("steps") or []:
+                u = sg.uses_name(str(st.get("uses") or ""))
+                wi = {k: sg.subst(str(v), ctx) for k, v in (st.get("with") or {}).items()}
+                if u == "actions/setup-node":
+                    if wi.get("node-version"):
+                        f.node.append(wi["node-version"])
+                    elif wi.get("node-version-file"):
+                        f.node.append(read(root, wi["node-version-file"]))
+                elif u == "pnpm/action-setup" and wi.get("version"):
+                    f.pnpm.append(wi["version"])
+                elif u == "actions/setup-python":
+                    if wi.get("python-version"):
+                        f.python.append(wi["python-version"])
+                    elif wi.get("python-version-file"):
+                        f.python.append(read(root, wi["python-version-file"]))
+                elif u == "browser-actions/setup-chrome":
+                    f.chrome = True
+                run = sg.subst(str(st.get("run") or ""), ctx)
+                for part in re.split(r"&&|;|\n", run):
+                    t = part.strip()
+                    m = re.match(r"(?:sudo )?(?:python3? -m )?pip3? install (.*)", t)
+                    if m:
+                        toks = shlex.split(m.group(1))
+                        i = 0
+                        while i < len(toks):
+                            x = toks[i]
+                            if x in ("-r", "--requirement"):
+                                f.pip_req_files.append(toks[i + 1])
+                                i += 2
+                                continue
+                            if x in ("-e", "--editable", "-c", "--constraint", "-i", "--index-url"):
+                                f.notes.append(f"pip install {x} {toks[i + 1] if i + 1 < len(toks) else ''} は写していない（段の中で流す）")
+                                i += 2
+                                continue
+                            if not x.startswith("-") and x not in f.pip:
+                                f.pip.append(x)
+                            i += 1
+                    m = re.match(r"(?:sudo )?apt(?:-get)? (?:-\S+ )*install (.*)", t)
+                    if m:
+                        f.apt += [x for x in shlex.split(m.group(1)) if not x.startswith("-") and x not in f.apt]
+                    if re.search(r"\bplaywright install\b", t) and t not in f.playwright:
+                        f.playwright.append(t)
+                    if re.search(r"google-chrome|channel[\"']?\s*[:=]\s*[\"']chrome", t):
+                        f.chrome = True
+    return f
+
+
+def chrome_in_repo(root: str) -> bool:
+    """GitHub の実行機には Google Chrome が最初からある。テストが channel: chrome を使うなら道具箱に要る"""
+    pat = re.compile(r"channel[\"']?\s*[:=]\s*[\"']chrome[\"']|PW_CHANNEL\s*[:=]\s*[\"']?chrome\b|google-chrome")
+    for p in glob.glob(os.path.join(root, "**", "playwright.config.*"), recursive=True) + \
+            glob.glob(os.path.join(root, "**", "*.spec.ts"), recursive=True)[:400]:
+        if "node_modules" in p:
+            continue
+        try:
+            if pat.search(open(p, encoding="utf-8", errors="ignore").read()):
+                return True
+        except OSError:
+            pass
+    return False
+
+
+def q(s) -> str:
+    """YAML に安全に書く（JSON の文字列は YAML として読める）"""
+    return json.dumps(str(s), ensure_ascii=False)
+
+
+def build(root: str, wfs: list[str], offline: bool) -> tuple[str, list[str]]:
+    notes: list[str] = []
+    # 外す job（理由は機械で決めたもの。読んで直す）
+    skip_jobs, skip_steps = {}, {}
+    for wf in wfs:
+        w = sg.load_yaml(os.path.join(root, wf))
+        for job, j in (w.get("jobs") or {}).items():
+            if not isinstance(j, dict):
+                continue
+            why = sg.unsupported_job(j)
+            if why:
+                skip_jobs[job] = f"{why}。dagci では流さない（init-ci が書いた理由・読んで直す）"
+                continue
+            for i, st in enumerate(j.get("steps") or []):
+                if st.get("run") and "secrets." in json.dumps(st, ensure_ascii=False):
+                    label = str(st.get("name") or st.get("run") or f"#{i}").strip().splitlines()[0][:80]
+                    skip_steps[f"{job}/{label}"] = "秘密（secrets）が要る手順。dagci の段には秘密を渡さない（init-ci が書いた理由・読んで直す）"
+    g = {"workflows": wfs, "skip_jobs": skip_jobs, "skip_steps": skip_steps}
+    f = scan(root, wfs, g)
+    pj = json.loads(read(root, "package.json") or "{}")
+    pm = str(pj.get("packageManager") or "")
+    has_node = bool(pj) or bool(f.node)
+    # Node の版：workflow → .nvmrc・.node-version → package.json の engines
+    node_spec = (f.node or [read(root, ".nvmrc") or read(root, ".node-version")] or [""])[0] or \
+        str((pj.get("engines") or {}).get("node") or "") or "22"
+    if len(set(f.node)) > 1:
+        notes.append(f"workflow の node-version が 1 つでない {sorted(set(f.node))}。最初の {f.node[0]} にした")
+    node_v = exact_node(node_spec, offline) if has_node else ""
+    # 部品の道具：packageManager（版まで）→ pnpm/action-setup の version → lockfile
+    tool, tool_v = "", ""
+    m = re.match(r"(pnpm|yarn|npm|bun)@([\w.\-]+)", pm)
+    if m:
+        tool, tool_v = m.group(1), m.group(2).split("+")[0]
+    elif f.pnpm or os.path.exists(os.path.join(root, "pnpm-lock.yaml")):
+        tool, tool_v = "pnpm", (f.pnpm or ["9"])[0]
+    elif os.path.exists(os.path.join(root, "yarn.lock")):
+        tool = "yarn"
+    elif has_node:
+        tool = "npm"
+    # Python の版：workflow → .python-version
+    py_spec = (f.python or [read(root, ".python-version")])[0]
+    use_py = bool(py_spec or f.pip or f.pip_req_files)
+    py_spec = py_spec or "3.12"
+    pins = []
+    pip_pkgs = []
+    for p in f.pip:
+        r, pinned = pin_pypi(p, offline)
+        pip_pkgs.append(r)
+        if pinned:
+            pins.append(r)
+    if pins:
+        notes.append(f"版の書いていない Python の部品を、今の最新に固定した: {', '.join(pins)}")
+    d = sg.derive(root, g)
+    services = d.services
+    needs_pg = any(PG_IMAGE.search(s["image"]) for s in services.values())
+    chrome = f.chrome or chrome_in_repo(root)
+    apt = ["git", "curl", "ca-certificates", "python3", "python3-pip", "python3-venv"] + \
+        (["postgresql-client"] if needs_pg else []) + [x for x in f.apt if x not in ("git", "curl")]
+    apt = list(dict.fromkeys(apt))
+
+    L: list[str] = []
+    w = L.append
+    w("# dagci の設定（dagci init-ci が作った下書き。形の説明は <スキル>/references/ci.md）")
+    w(f"#   読んだ workflow: {', '.join(wfs)}")
+    w("#   段は手で写さず、workflow から毎回導く（include の dagci stages）。workflow を直せば段も変わる")
+    note_at = len(L)   # 注は最後に差し込む（準備を書くときに見つかる注もある）
+    w("version: 1")
+    w(f"project: {q(os.path.basename(os.path.abspath(root)).lower())}")
+    w("workdir: /src")
+    w("git: {base: main, history: true}")
+    w("")
