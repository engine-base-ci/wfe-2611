-def matches(patterns: list[str], path: str) -> bool:
-    pos = [p for p in patterns if not p.startswith("!")]
-    neg = [p[1:] for p in patterns if p.startswith("!")]
-    return any(glob_re(p).match(path) for p in pos) and not any(glob_re(p).match(path) for p in neg)
