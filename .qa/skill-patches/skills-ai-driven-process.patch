--- orig/ai-team-delivery/scripts/gates/generated_gate.py	1970-01-01 00:00:00.000000000 +0000
+++ new/ai-team-delivery/scripts/gates/generated_gate.py	2026-11-05 01:00:16.553224814 +0000
@@ -0,0 +1,175 @@
+#!/usr/bin/env python3
+"""生成物が最新か（標準の検査・あるプロジェクトの G38 から汎用にした）。設定は ci-gates.yaml の generated:。
+
+  python3 <skill>/scripts/gates/generated_gate.py [--root <根>] [--config <ci-gates.yaml>]
+  python3 <skill>/scripts/gates/generated_gate.py --selftest    一時のリポジトリで、古い生成物・目録に無い生成物を赤にできるか
+
+作り手（生成器）を順に全部回し、作る前と後で中身が変わった生成物を赤にする。回し終えたら作業中のファイルは全部元に戻す。
+赤になるもの:
+  F1 作り手を回したら中身が変わった（＝コミットされている生成物が古い）。日付（2026-11-04 など）だけの違いは見ない
+  F2 作り手が落ちた
+  F3 目録に無い生成物（先頭 3 行に「生成物」「DO NOT EDIT」などと書いたファイルが、どの作り手の outputs にも入っていない）
+  F4 古いと記録した物（known_stale）が、もう古くない（記録を外す）
+由来：生成器を足したのに CI で回しておらず、手で直した生成物や古い生成物が気づかれずに残った。
+
+設定（ci-gates.yaml）:
+  generated:
+    generators:                       # 作り手。上から順に回す（前の作り手の出力を次が読むなら、その順に並べる）
+      - {name: API の型, run: "npm run -s codegen", outputs: ["src/api/types.ts"]}
+    known_stale: []                   # 古いのを知っていて後で直すもの [{path|glob, ticket}]。増えたら赤・直ったら外す
+    not_generated: []                 # 印が付いているが生成物ではない [{path, why}]
+    elsewhere: []                     # 別の検査が最新かを見ている生成物 [{outputs: [glob], by}]
+    skip_prefix: [".git/", "node_modules/"]
+    marker: '生成物|機械生成|手で直さない|自動生成|DO NOT EDIT|Do not edit|auto-generated|@generated|Code generated'
+"""
+from __future__ import annotations
+import fnmatch, json, os, re, shutil, subprocess, sys, tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from _common import config, not_used, root_from_args  # noqa: E402
+
+DATE = re.compile(rb"\d{4}-\d{2}-\d{2}(T[\d:.]+Z?)?")
+DEFAULT_MARK = r"生成物|機械生成|手で直さない|手で書かない|自動生成|DO NOT EDIT|Do not edit|auto-generated|@generated|Code generated"
+CODE_EXT = (".py", ".mjs", ".js", ".cjs", ".ts", ".sh", ".go", ".rb")
+
+
+class Gate:
+    def __init__(self, root: str, cfg: dict):
+        self.root, self.cfg = root, cfg
+        self.mark = re.compile(cfg.get("marker") or DEFAULT_MARK)
+        self.skip = tuple(cfg.get("skip_prefix") or [".git/", "node_modules/", ".claude/", ".ai-team/", ".ai-team-out/"])
+
+    def git(self, *a: str) -> list[str]:
+        out = subprocess.run(["git", *a], cwd=self.root, capture_output=True, text=True).stdout
+        return [f for f in out.split("\n") if f]
+
+    def read(self, f: str) -> bytes | None:
+        try:
+            with open(os.path.join(self.root, f), "rb") as h:
+                return h.read()
+        except (FileNotFoundError, IsADirectoryError):
+            return None
+
+    def known(self, path: str) -> dict | None:
+        for k in self.cfg.get("known_stale") or []:
+            if k.get("path") == path or ("glob" in k and fnmatch.fnmatch(path, k["glob"])):
+                return k
+        return None
+
+    def run_all(self) -> tuple[dict[str, list[str]], list[str]]:
+        files = self.git("ls-files")
+        before = {f: self.read(f) for f in files}
+        extra_before = set(self.git("ls-files", "--others", "--exclude-standard"))
+        seen = dict(before)
+        changed: dict[str, list[str]] = {}
+        broken: list[str] = []
+        try:
+            for g in self.cfg.get("generators") or []:
+                r = subprocess.run(g["run"], cwd=self.root, shell=True, capture_output=True, text=True)
+                if r.returncode != 0:
+                    broken.append(f'{g["name"]}（{g["run"]}）: {(r.stderr or r.stdout).strip().splitlines()[-1:]}')
+                hit = []
+                for f in files:
+                    now = self.read(f)
+                    if now != seen[f]:
+                        seen[f] = now
+                        if now is None or before[f] is None or DATE.sub(b"D", now) != DATE.sub(b"D", before[f]):
+                            hit.append(f)
+                for f in sorted(set(self.git("ls-files", "--others", "--exclude-standard")) - extra_before):
+                    if f not in seen:
+                        seen[f] = None
+                        hit.append(f + "（新しくできた）")
+                if hit:
+                    changed[g["name"]] = hit
+        finally:  # 元に戻す（落ちても手元を汚さない）
+            for f, b in before.items():
+                if b is not None and self.read(f) != b:
+                    with open(os.path.join(self.root, f), "wb") as h:
+                        h.write(b)
+            for f in set(self.git("ls-files", "--others", "--exclude-standard")) - extra_before:
+                p = os.path.join(self.root, f)
+                if os.path.isfile(p):
+                    os.remove(p)
+        return changed, broken
+
+    def unlisted(self) -> list[str]:
+        files = sorted(set(self.git("ls-files")) | set(self.git("ls-files", "--others", "--exclude-standard")))
+        outs = [o for g in self.cfg.get("generators") or [] for o in g.get("outputs") or []]
+        outs += [o for e in self.cfg.get("elsewhere") or [] for o in e.get("outputs") or []]
+        nogen = {n["path"] for n in self.cfg.get("not_generated") or []}
+        bad = []
+        for f in files:
+            if f.startswith(self.skip) or f.endswith(CODE_EXT) or f in nogen or f == "ci-gates.yaml" \
+                    or any(fnmatch.fnmatch(f, o) for o in outs) or self.known(f):
+                continue
+            try:
+                with open(os.path.join(self.root, f), encoding="utf-8") as h:
+                    head = "".join([h.readline() for _ in range(3)])
+            except (UnicodeDecodeError, FileNotFoundError, IsADirectoryError):
+                continue
+            if self.mark.search(head):
+                bad.append(f)
+        return bad
+
+    def check(self) -> tuple[list[str], list[str], int]:
+        changed, broken = self.run_all()
+        fails, warns, still = [], [], set()
+        for name, fs in changed.items():
+            for f in fs:
+                k = self.known(f.replace("（新しくできた）", ""))
+                if k:
+                    still.add(json.dumps(k, ensure_ascii=False, sort_keys=True))
+                    warns.append(f"記録どおり古い（{k.get('ticket', '理由なし')}）: {f}")
+                else:
+                    fails.append(f"F1 {name} を回すと変わる（コミットされている生成物が古い）: {f}")
+        for k in self.cfg.get("known_stale") or []:
+            if "path" in k and json.dumps(k, ensure_ascii=False, sort_keys=True) not in still:
+                fails.append(f"F4 古いと記録した物が、もう古くない（known_stale から外す）: {k['path']}")
+        fails += [f"F2 作り手が落ちた: {b}" for b in broken]
+        fails += [f"F3 目録に無い生成物（generators に作り手を足すか、not_generated に理由を書く）: {f}" for f in self.unlisted()]
+        return fails, warns, sum(len(v) for v in changed.values())
+
+
+def report(g: Gate) -> int:
+    fails, warns, n = g.check()
+    for w in warns[:20]:
+        print("  warn", w)
+    for f in fails:
+        print("  ★", f)
+    print(f"作り手 {len(g.cfg.get('generators') or [])} ／ 変わった生成物 {n}（記録どおり {len(warns)}）")
+    print("FAIL — 生成物が古い" if fails else "PASS — 生成物は全部最新（記録したものを除く）")
+    return 1 if fails else 0
+
+
+def selftest() -> int:
+    d = tempfile.mkdtemp(prefix="gen-gate-selftest-")
+    try:
+        sh = lambda *a: subprocess.run(list(a), cwd=d, check=True, capture_output=True)
+        sh("git", "init", "-q")
+        open(os.path.join(d, "src.txt"), "w").write("hello\n")
+        gen = f"{sys.executable} -c \"open('out.txt','w').write('# 生成物。手で直さない\\n'+open('src.txt').read())\""
+        cfg = {"generators": [{"name": "写し", "run": gen, "outputs": ["out.txt"]}]}
+        subprocess.run(gen, cwd=d, shell=True, check=True)
+        sh("git", "add", "-A")
+        ok_fresh = not Gate(d, cfg).check()[0]                        # 最新なら緑
+        open(os.path.join(d, "src.txt"), "w").write("changed\n")
+        f1 = any(x.startswith("F1") for x in Gate(d, cfg).check()[0])  # 正本だけ変えて生成物が古い → 赤
+        same = open(os.path.join(d, "out.txt")).read().endswith("hello\n")  # 回し終えたら元に戻している
+        open(os.path.join(d, "other.md"), "w").write("<!-- DO NOT EDIT: generated -->\n")
+        f3 = any("other.md" in x and x.startswith("F3") for x in Gate(d, cfg).check()[0])  # 目録に無い生成物 → 赤
+        bad = {"generators": [{"name": "落ちる", "run": "exit 3", "outputs": []}]}
+        f2 = any(x.startswith("F2") for x in Gate(d, bad).check()[0])
+    finally:
+        shutil.rmtree(d, ignore_errors=True)
+    ok = ok_fresh and f1 and same and f3 and f2
+    print("PASS — 最新は緑・古い生成物・落ちる作り手・目録に無い生成物は赤・手元は元に戻した" if ok else
+          f"FAIL — 見つけられない（最新 {ok_fresh}・F1 {f1}・戻した {same}・F3 {f3}・F2 {f2}）")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    if "--selftest" in sys.argv:
+        sys.exit(selftest())
+    root = root_from_args()
+    c = config(root, "generated")
+    sys.exit(not_used("generated") if c is None else report(Gate(root, c)))
diff -ruN orig/ai-team-delivery/scripts/gates/wiring_gate.py new/ai-team-delivery/scripts/gates/wiring_gate.py
--- orig/ai-team-delivery/scripts/gates/wiring_gate.py	1970-01-01 00:00:00.000000000 +0000
+++ new/ai-team-delivery/scripts/gates/wiring_gate.py	2026-11-05 01:00:16.553874084 +0000
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""書いた検査が CI から回っているか（標準の検査・あるプロジェクトの G47 から汎用にした）。設定は ci-gates.yaml の wiring:。
+
+  python3 <skill>/scripts/gates/wiring_gate.py [--root <根>] [--config <ci-gates.yaml>]
+  python3 <skill>/scripts/gates/wiring_gate.py --selftest    一時のリポジトリで、どこからも回らない検査を赤にできるか
+
+検査の候補（checks の glob に当たる台本・package.json の scripts で prefix に当たるもの・自己試験の旗を持つ台本）が、
+CI の設定（ci_files：GitHub Actions・dagci の ci.yaml など）の文面か、段の一覧を出す命令（stage_cmds）の出力に出てくるかを見る。
+赤になるもの:
+  W1 どこからも回らない検査（CI に足すか、exceptions に理由を書く）
+  W2 壊れていると記録した検査（known_broken）が、もう緑（記録を外して CI に入れる）
+  W3 例外・壊れていると記録したのに、もう無い検査（記録から外す）
+由来：検査を書いたのに CI で回しておらず、壊れたまま気づかなかった（自己試験が赤のまま・本体の条件の誤りで何も見ていなかった）。
+
+設定（ci-gates.yaml）:
+  wiring:
+    ci_files: [".github/workflows/*.yml", "ci.yaml"]   # 検査を流す設定。文面に命令かファイル名が出てくれば「回っている」
+    stage_cmds: []                 # 段の一覧を出す命令（ci.yaml の include から導く段など。出力も文面に足す）
+    checks: ["scripts/ci/*.py", "scripts/ci/*.mjs", "scripts/ci/*.sh"]
+    package_scripts: "ci:"         # package.json の scripts で、この頭のもの（無ければ空にする）
+    selftest_flag: "--selftest"    # この文字を含む台本は「<台本> --selftest」も 1 つの検査として数える
+    exceptions: {}                 # {名前: 回さない理由}（作り手・手元用の道具など）
+    known_broken: {}               # {名前: チケット}。直ったら W2
+"""
+from __future__ import annotations
+import glob, json, os, re, shutil, subprocess, sys, tempfile
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from _common import config, not_used, root_from_args  # noqa: E402
+
+SELF = "wiring_gate.py"
+
+
+def runner(rel: str) -> str:
+    return {".py": "python3", ".mjs": "node", ".js": "node", ".cjs": "node", ".sh": "bash"}.get(os.path.splitext(rel)[1], "")
+
+
+class Gate:
+    def __init__(self, root: str, cfg: dict):
+        self.root, self.cfg = root, cfg
+
+    def text(self) -> str:
+        t = ""
+        for g in self.cfg.get("ci_files") or [".github/workflows/*.yml", ".github/workflows/*.yaml", "ci.yaml"]:
+            for f in sorted(glob.glob(os.path.join(self.root, g))):
+                t += open(f, encoding="utf-8").read() + "\n"
+        for c in self.cfg.get("stage_cmds") or []:
+            r = subprocess.run(c, cwd=self.root, shell=True, capture_output=True, text=True)
+            if r.returncode != 0:
+                sys.exit(f"段の一覧を出す命令が落ちた: {c}\n{r.stderr[-400:]}")
+            t += r.stdout + "\n"
+        return t
+
+    def items(self) -> dict[str, str]:
+        out: dict[str, str] = {}
+        pre = self.cfg.get("package_scripts", "ci:")
+        pj = os.path.join(self.root, "package.json")
+        if pre and os.path.exists(pj):
+            for k, v in (json.load(open(pj, encoding="utf-8")).get("scripts") or {}).items():
+                if k.startswith(pre):
+                    out[k] = v
+        flag = self.cfg.get("selftest_flag", "--selftest")
+        for g in self.cfg.get("checks") or ["scripts/ci/*.py", "scripts/ci/*.mjs", "scripts/ci/*.sh"]:
+            for f in sorted(glob.glob(os.path.join(self.root, g))):
+                rel = os.path.relpath(f, self.root)
+                if os.path.basename(rel) == SELF or os.path.basename(rel).startswith("_"):
+                    continue
+                if not any(rel in v for v in out.values()):
+                    out[rel] = f"{runner(rel)} {rel}".strip()
+                if flag and flag in open(f, encoding="utf-8", errors="ignore").read():
+                    out[f"{rel} {flag}"] = f"{runner(rel)} {rel} {flag}".strip()
+        return out
+
+    def wired(self, name: str, cmd: str, text: str, items: dict[str, str]) -> bool:
+        pre = self.cfg.get("package_scripts", "ci:")
+        if pre and name.startswith(pre) and re.search(rf"(?:run|pnpm|yarn|bun)(?: -s)? {re.escape(name)}\b", text):
+            return True
+        if " " in name:   # 「台本 --selftest」は、その形で書かれていること
+            return name in text or cmd in text
+        if name in text:
+            return True
+        for k, v in items.items():  # 回っている package.json の scripts から呼ばれている
+            if k != name and pre and k.startswith(pre) and name in v and self.wired(k, v, text, {}):
+                return True
+        return False
+
+    def check(self) -> list[str]:
+        ex = self.cfg.get("exceptions") or {}
+        broken = self.cfg.get("known_broken") or {}
+        text, it, fails = self.text(), self.items(), []
+        for name, cmd in sorted(it.items()):
+            if name in ex:
+                continue
+            if name in broken:
+                if subprocess.run(cmd, cwd=self.root, shell=True, capture_output=True).returncode == 0:
+                    fails.append(f"W2 壊れていると記録した {name} が、もう緑（known_broken から外して CI に入れる）")
+                continue
+            if not self.wired(name, cmd, text, it):
+                fails.append(f"W1 どこからも回らない検査 {name}（{cmd[:80]}）")
+        for name in [*ex, *broken]:
+            if name not in it and not os.path.exists(os.path.join(self.root, name.split(" ")[0])):
+                fails.append(f"W3 記録したのに、もう無い {name}")
+        return fails
+
+
+def report(g: Gate) -> int:
+    fails = g.check()
+    for f in fails:
+        print("  ★", f)
+    print(f"検査と道具 {len(g.items())} 個")
+    print("FAIL — 回っていない検査がある" if fails else "PASS — 書いた検査は全部 CI から回る（理由つきの例外を除く）")
+    return 1 if fails else 0
+
+
+def selftest() -> int:
+    d = tempfile.mkdtemp(prefix="wiring-gate-selftest-")
+    try:
+        os.makedirs(os.path.join(d, "scripts/ci"))
+        os.makedirs(os.path.join(d, ".github/workflows"))
+        w = lambda p, s: open(os.path.join(d, p), "w").write(s)
+        w("scripts/ci/a.py", "print('a')  # --selftest\n")
+        w("scripts/ci/b.py", "print('b')\n")
+        w("package.json", json.dumps({"scripts": {"ci:x": "node scripts/ci/x.mjs", "ci:y": "pnpm -s ci:x"}}))
+        w("scripts/ci/x.mjs", "")
+        w(".github/workflows/ci.yml", "steps:\n  - run: python3 scripts/ci/a.py --selftest && python3 scripts/ci/a.py\n  - run: pnpm -s ci:y\n")
+        cfg = {"ci_files": [".github/workflows/*.yml"]}
+        fails = Gate(d, cfg).check()
+        w1 = any("scripts/ci/b.py" in f and f.startswith("W1") for f in fails)       # 回っていない台本 → 赤
+        quiet = not any(("a.py" in f) or ("ci:x" in f) or ("ci:y" in f) for f in fails)  # 回っている物（間接も）は黙る
+        ok_ex = not Gate(d, {**cfg, "exceptions": {"scripts/ci/b.py": "手元用"}}).check()
+        w3 = any(f.startswith("W3") for f in Gate(d, {**cfg, "exceptions": {"scripts/ci/b.py": "x", "scripts/ci/gone.py": "x"}}).check())
