+#!/usr/bin/env python3
+"""dagci smoke の容れ物の中の確かめ（dagci が呼ぶ）。1 項目ずつ JSON の 1 行で出す: {"ok": 真偽, "what": 項目, "msg": 中身}
+
+  python3 smoke_probe.py <spec.json>
+  spec: {"runtime": true, "registries": [{"name","url"}], "services": [{"name","ports","kind","user","password","db"}],
+         "commands": [{"name","run","timeout"}], "workdir": "/src"}
+この台本は必ず 0 で終わる（赤は出力で返す）。
+"""
+import json
+import os
+import shutil
+import socket
+import subprocess
+import sys
+import time
+
+spec = json.load(open(sys.argv[1], encoding="utf-8"))
+WD = spec.get("workdir", "/src")
+
+
+def say(ok, what, msg):
+    print(json.dumps({"ok": bool(ok), "what": what, "msg": " ".join(str(msg).split())[:400]}, ensure_ascii=False), flush=True)
+
+
+def sh(cmd, timeout=60, cwd=None):
+    try:
+        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True, text=True, timeout=timeout, cwd=cwd or WD)
+        return r.returncode, (r.stdout + r.stderr).strip()
+    except subprocess.TimeoutExpired:
+        return 124, f"{timeout} 秒で返らない"
+    except OSError as ex:
+        return 127, str(ex)
+
+
+PY_IMPORTS = r'''
+import importlib, importlib.metadata as md, json, os, site, sys
+venv = os.environ.get("VIRTUAL_ENV")
+res = {"prefix": sys.prefix, "exe": sys.executable, "ver": sys.version.split()[0], "venv": venv, "mods": [], "bad": []}
+if venv:
+    paths = [p for p in site.getsitepackages() if p.startswith(sys.prefix)]
+    skip = {"pip", "setuptools", "pkg_resources", "wheel", "_distutils_hack", "distutils-precedence"}
+    for d in md.distributions(path=paths):
+        tops = (d.read_text("top_level.txt") or "").split()
+        if not tops:
+            for f in d.files or []:
+                p = str(f).split("/")
+                if p[0].endswith((".dist-info", ".data")) or p[0] in ("..", "__pycache__", "bin"):
+                    continue
+                if len(p) > 1 and p[1] == "__init__.py":
+                    tops.append(p[0])
+                elif len(p) == 1 and p[0].endswith(".py"):
+                    tops.append(p[0][:-3])
+        for t in sorted(set(tops)):
+            if not (t.startswith("_") or t in skip or not t.isidentifier()) and t not in res["mods"]:
+                res["mods"].append(t)
+    # 2 回まで試す（psycopg_binary のように、ほかの部品を先に読む決まりの物がある）
+    left = list(res["mods"])
+    for last in (False, True):
+        again = []
+        for t in left:
+            try:
+                importlib.import_module(t)
+            except BaseException as ex:
+                again.append(t)
+                if last:
+                    res["bad"].append(f"{t}: {type(ex).__name__}: {str(ex)[:80]}")
+        left = again
+print(json.dumps(res))
+'''
+
+
+def runtime():
+    # Python（段の包みも python3 で流れる）
+    rc, out = sh(["python3", "-c", PY_IMPORTS], timeout=180)
+    try:
+        r = json.loads(out.splitlines()[-1])
+    except (ValueError, IndexError):
+        say(False, "Python", f"python3 が動かない: {out[-200:]}")
+        r = None
+    if r:
+        venv_ok = not r["venv"] or os.path.realpath(r["prefix"]) == os.path.realpath(r["venv"])
+        if not venv_ok:
+            say(False, "Python", f"python3（{r['exe']}）が venv {r['venv']} と見なされていない（sys.prefix={r['prefix']}）。"
+                "PATH の先頭に venv の bin を置く（links を張らない）")
+        elif r["bad"]:
+            say(False, "Python の部品", f"import できない {len(r['bad'])} 個: {'; '.join(r['bad'][:4])}")
+        else:
+            say(True, "Python", f"{r['exe']} {r['ver']}・sys.prefix={r['prefix']}" +
+                (f"・部品 {len(r['mods'])} 個を import できた" if r["venv"] else "（venv なし）"))
+    # Node と部品の道具
+    pj_path = os.path.join(WD, "package.json")
+    if shutil.which("node") or os.path.exists(pj_path):
+        rc, v = sh(["node", "--version"])
+        if rc != 0:
+            say(False, "Node", f"node が無い・動かない（package.json がある）: {v[-200:]}")
+            return
+        msg = f"node {v}"
+        pj = json.load(open(pj_path, encoding="utf-8")) if os.path.exists(pj_path) else {}
+        pm = str(pj.get("packageManager") or "")
+        if pm:
+            tool, _, want = pm.partition("@")
+            want = want.split("+")[0]
+            rc, got = sh([tool, "--version"])
+            if rc != 0:
+                say(False, "Node", f"{msg}・{tool} が無い（packageManager: {pm}）")
+                return
+            if want and got.strip() != want:
+                say(False, "Node", f"{msg}・{tool} {got.strip()} が packageManager の {want} と違う")
+                return
+            msg += f"・{tool} {got.strip()}（packageManager と同じ）"
+        say(True, "Node", msg)
+        # 部品の入り：package.json の依存が node_modules にあるか（root と workspace）
+        miss, n, files = [], 0, []
+        for d, dirs, fs in os.walk(WD):
+            dirs[:] = [x for x in dirs if x not in ("node_modules", ".git") and not x.startswith(".")]
+            if d.count(os.sep) - WD.count(os.sep) > 3:
+                dirs[:] = []
+            if "package.json" in fs:
+                files.append(os.path.join(d, "package.json"))
+        for f in files:
+            try:
+                p = json.load(open(f, encoding="utf-8"))
+            except ValueError:
+                continue
+            for k in list((p.get("dependencies") or {})) + list((p.get("devDependencies") or {})):
+                n += 1
+                d, found = os.path.dirname(f), False
+                while True:
+                    if os.path.exists(os.path.join(d, "node_modules", k)):
+                        found = True
+                        break
+                    if d == WD or d == "/":
+                        break
+                    d = os.path.dirname(d)
+                if not found:
+                    miss.append(f"{os.path.relpath(f, WD)}:{k}")
+        if miss:
+            say(False, "Node の部品", f"node_modules に無い {len(miss)} 個（準備の install が足りない）: {', '.join(miss[:5])}")
+        elif files:
+            say(True, "Node の部品", f"package.json {len(files)} 本の依存 {n} 個が node_modules にある")
+
+
+NODE_GET = ("const u=process.argv[1];require('https').get(u,r=>{console.log(r.statusCode);process.exit(r.statusCode<400?0:1)})"
+            ".on('error',e=>{console.log(e.code||e.message);process.exit(1)}).setTimeout(20000,function(){this.destroy(new Error('timeout'))})")
+PY_GET = ("import sys,urllib.request\ntry:\n r=urllib.request.urlopen(sys.argv[1],timeout=20);print(r.status)\n"
+          "except Exception as e:\n print(type(e).__name__, str(e)[:160]);sys.exit(1)")
+
+
+def registries():
+    for reg in spec.get("registries") or []:
+        url = reg["url"]
+        tools = []
+        if shutil.which("curl"):
+            tools.append(("curl", ["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "20", url]))
+        if shutil.which("node"):
+            tools.append(("node", ["node", "-e", NODE_GET, url]))
+        tools.append(("python3", ["python3", "-c", PY_GET, url]))
+        for name, cmd in tools:
+            rc, out = sh(cmd, timeout=40)
+            code = out.strip().splitlines()[-1] if out.strip() else ""
+            ok = rc == 0 and (name != "curl" or (code.isdigit() and int(code) < 400))
+            hint = ""
+            if not ok and ("CERT" in out.upper() or "certificate" in out):
+                hint = {"node": "（NODE_EXTRA_CA_CERTS を toolbox.env に）", "python3": "（SSL_CERT_FILE を toolbox.env に）"}.get(name, "")
+            say(ok, f"https（{reg['name']}・{name}）", f"{url} {code}{hint}")
+
+
+def services():
+    for s in spec.get("services") or []:
+        host = s["name"]
+        for port in s.get("ports") or []:
+            t0, err = time.time(), ""
+            ok = False
+            while time.time() - t0 < 60:
+                try:
+                    with socket.create_connection((host, int(port)), timeout=5):
+                        ok = True
+                        break
+                except OSError as ex:
+                    err = str(ex)
+                    time.sleep(1)
+            if not ok:
+                say(False, f"相手 {host}", f"TCP {port} につながらない: {err}")
+                continue
+            if s.get("kind") == "postgres":
+                user, pw, db = s.get("user") or "postgres", s.get("password") or "", s.get("db") or s.get("user") or "postgres"
+                if not shutil.which("psql"):
+                    say(True, f"相手 {host}", f"TCP {port}（psql が道具箱に無いので select 1 は見ていない。postgresql-client を入れる）")
+                    continue
+                env = {**os.environ, "PGPASSWORD": pw, "PGCONNECT_TIMEOUT": "10"}
+                for _ in range(30):
+                    r = subprocess.run(["pg_isready", "-h", host, "-p", str(port), "-U", user], capture_output=True, text=True, env=env)
+                    if r.returncode == 0:
+                        break
+                    time.sleep(1)
+                r = subprocess.run(["psql", "-h", host, "-p", str(port), "-U", user, "-d", db, "-tAc", "select 1"],
+                                   capture_output=True, text=True, env=env, timeout=60)
+                say(r.returncode == 0 and r.stdout.strip() == "1", f"相手 {host}",
+                    f"TCP {port}・pg_isready・select 1" if r.returncode == 0 else f"select 1 が通らない: {(r.stderr or r.stdout)[-200:]}")
+            elif s.get("kind") == "redis":
+                try:
+                    with socket.create_connection((host, int(port)), timeout=5) as c:
+                        c.sendall(b"PING\r\n")
+                        got = c.recv(64)
+                    say(b"PONG" in got, f"相手 {host}", f"TCP {port}・PING → {got[:20]!r}")
+                except OSError as ex:
+                    say(False, f"相手 {host}", f"PING が通らない: {ex}")
+            else:
+                say(True, f"相手 {host}", f"TCP {port}")
+
+
+def commands():
+    for c in spec.get("commands") or []:
+        t = time.time()
+        rc, out = sh(["bash", "-c", c["run"]], timeout=int(c.get("timeout") or 300))
+        tail = " / ".join(out.splitlines()[-3:])
+        say(rc == 0, f"smoke「{c['name']}」", f"{time.time() - t:.0f} 秒" + ("" if rc == 0 else f"・終わり方 {rc}: {tail}"))
+
+
+for part in (runtime if spec.get("runtime") else None, registries, services, commands):
+    if part:
+        try:
+            part()
+        except Exception as ex:   # 確かめの途中の例外も赤で返す（素通りさせない）
+            say(False, part.__name__, f"確かめが落ちた: {type(ex).__name__}: {ex}")
