+"""標準の検査（scripts/gates/）の共通部分。設定はプロジェクトの根の ci-gates.yaml（雛形 assets/ci/ci-gates.example.yaml）。
+
+どの検査も:
+  - プロジェクトの根（git の根・無ければ今の場所）で流す。--root で替えられる
+  - 設定の自分の節（generated・wiring・deps）だけを読む。節が無ければ「使っていない」と言って緑で終わる（入れる前のプロジェクトを赤にしない）
+  - --selftest で「わざと壊した形を赤にできるか」を確かめる（検査が働いていることの証拠）
+"""
+from __future__ import annotations
+import os, subprocess, sys
+
+
+def root_from_args() -> str:
+    if "--root" in sys.argv:
+        return os.path.abspath(sys.argv[sys.argv.index("--root") + 1])
+    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
+    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else os.getcwd()
+
+
+def config(root: str, section: str) -> dict | None:
+    path = os.environ.get("CI_GATES_CONFIG") or os.path.join(root, "ci-gates.yaml")
+    if "--config" in sys.argv:
+        path = sys.argv[sys.argv.index("--config") + 1]
+    if not os.path.exists(path):
+        return None
+    try:
+        import yaml
+    except ImportError:
+        sys.exit("PyYAML が要る（pip install pyyaml）")
+    with open(path, encoding="utf-8") as f:
+        data = yaml.safe_load(f) or {}
+    return data.get(section)
+
+
+def not_used(section: str) -> int:
+    print(f"PASS — ci-gates.yaml に {section}: が無い（この検査は使っていない）")
+    return 0
