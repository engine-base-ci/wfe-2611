+#!/usr/bin/env python3
+"""dagci の段の一覧を、プロジェクトの GitHub の workflow から導く（手で写さない）。あるプロジェクトの scripts/ci/ci_stages.py を汎用にした。
+
+  dagci stages            段の一覧を YAML で出す（ci.yaml の include から呼ぶ）。1 対 1 が崩れていれば赤で止まる（設定の誤り）
+  dagci stages --check    workflow の手順が、どれも「段」「道具箱・準備で済ませた手順」「理由つきで外した物」の 1 つに入っているかを出す
+  （直に流すなら python3 stages_from_github.py [--root <根>] [--check]。PyYAML が要る）
+
+設定は ci.yaml の github: 節（dagci init-ci が書く。足りなければ手で足す）:
+  github:
+    workflows: [.github/workflows/ci.yml]     # 段を導く workflow
+    skip_jobs: {e2e: 理由}                     # 流さない job（理由が要る）
+    skip_steps: {"<job>/<手順の名前か命令>": 理由}
+    ignore_uses: {"<owner/action>": 理由}      # 知らない action を、写さなくてよいと決めたもの
+    setup: [正規表現]                          # 道具箱・準備で済ませる手順（足す。既定は install の類）
+    job_setup: [正規表現]                      # job の中で、後ろの段の前に毎回流す手順（足す。既定は build と、後ろで立ち上げる手順）
+
+GitHub の job の写し方:
+  services   → job ごとに別の相手 <job>-<名前>（同じ定義の相手を 1 つにまとめない・あるプロジェクトの G3 と G27・2026-11-04）
+               env と命令の localhost:<口>・127.0.0.1:<口> を相手の名前に向ける
+  相手のある job → 手順を順に流す（前の段を needs に。同じ DB を同時に作り直さない）
+  env        → workflow・job・手順の env を段の env に。${{ env.X }}・${{ matrix.X }}（最初の組）は値に置き換える
+  working-directory → cd してから流す。複数行の手順は GitHub と同じく set -eo pipefail で流す
+赤になるもの（--check と、段を出すとき）:
+  CS1 知らない action（uses:）を写していない（道具箱で入れるか、ignore_uses に理由を書く）
+  CS2 段の id が英数と ._- にならない（名前から作れない）
+  CS3 dagci で同じには流せない job（if: で GitHub の出来事に依る・Linux 以外・container:・別の workflow を呼ぶ）が skip_jobs に無い
+  CS4 外す記録（skip_jobs・skip_steps・ignore_uses）に理由が無い・もう無い物を指している
+  CS5 段に ${{ ... }} が残る（secrets など、dagci が値を知らない式）。skip_steps に理由を書くか、命令を変える
+  CS6 workflow が無い・段が 0 本
+"""
+from __future__ import annotations
+
+import os
+import re
+import shlex
+import sys
+
+import yaml
+
+# 写さなくてよい action（理由）。ここに無い action は CS1
+KNOWN_USES = {
+    "actions/checkout": "作業場は dagci が送る",
+    "actions/setup-node": "道具箱で入れる（init-ci が版を写す）",
+    "actions/setup-python": "道具箱で入れる（init-ci が版を写す）",
+    "pnpm/action-setup": "道具箱で入れる（init-ci が版を写す）",
+    "astral-sh/setup-uv": "道具箱で入れる",
+    "actions/cache": "Dagger が入力の中身で使い回す",
+    "actions/upload-artifact": "段の出力の全文は $DAGCI_HOME/runs に残る",
+    "actions/download-artifact": "段の出力の全文は $DAGCI_HOME/runs に残る",
+    "browser-actions/setup-chrome": "道具箱で入れる（init-ci が Chrome の手順を足す）",
+}
+DEFAULT_SETUP = [
+    r"^(sudo )?corepack (enable|prepare)(\s|$)",
+    r"^(pnpm|npm|yarn|bun) (install|ci|i)(\s|$)",
+    r"^(python3? -m )?pip3? install\b",
+    r"^uv (sync|pip install)\b",
+    r"\bplaywright install\b",
+    r"^(sudo )?apt(-get)? (-\S+ )*(update|install)\b",
+]
+DEFAULT_JOB_SETUP = [
+    r"^(pnpm|npm|yarn|bun)( run)?( -s)?( --filter \S+)? build(:\S+)?$",
+]
+BACKGROUND = re.compile(r"&\s*\)|&\s*$", re.M)   # 後ろで立ち上げる手順（画面・API を起こして待つ）
+EXPR = re.compile(r"\$\{\{\s*(.*?)\s*\}\}")
+LOCAL = r"(?:localhost|127\.0\.0\.1)"
+
+
+def gh_config(root: str) -> dict:
+    p = os.path.join(root, "ci.yaml")
+    if not os.path.exists(p):
+        return {}
+    with open(p, encoding="utf-8") as f:
+        return (yaml.safe_load(f) or {}).get("github") or {}
+
+
+def load_yaml(path: str) -> dict:
+    with open(path, encoding="utf-8") as f:
+        d = yaml.safe_load(f) or {}
+    if True in d and "on" not in d:   # YAML 1.1 は on: を真偽の True と読む
+        d["on"] = d.pop(True)
+    return d
+
+
+def subst(s: str, ctx: dict) -> str:
+    """${{ env.X }}・${{ matrix.X }}・${{ github.workspace }} を値に。分からない式はそのまま残す（CS5）"""
+    def one(m):
+        e = m.group(1)
+        k = re.fullmatch(r"(env|matrix)\.([A-Za-z_][A-Za-z0-9_-]*)", e)
+        if k and k.group(2) in ctx.get(k.group(1), {}):
+            return str(ctx[k.group(1)][k.group(2)])
+        if e == "github.workspace":
+            return ctx.get("workdir", "/src")
+        return m.group(0)
+    for _ in range(3):   # env の中の ${{ env.X }} もほどく
+        s2 = EXPR.sub(one, s)
+        if s2 == s:
+            break
+        s = s2
+    return s
+
+
+def first_matrix(j: dict) -> dict:
+    m = ((j.get("strategy") or {}).get("matrix")) or {}
+    if not isinstance(m, dict):
+        return {}
+    out = {}
+    for k, v in m.items():
+        if k in ("include", "exclude"):
+            continue
+        if isinstance(v, list) and v:
+            out[k] = v[0]
+    return out
+
+
+def service_key(job: str, name: str) -> str:
+    return re.sub(r"[^a-z0-9-]+", "-", f"{job}-{name}".lower()).strip("-")
+
+
+def job_services(job: str, j: dict, ctx: dict) -> dict[str, dict]:
+    """job の services を、dagci の相手（名前 <job>-<名前>）に。hostports は 手元の口 → 容れ物の口"""
+    out = {}
+    for name, sv in (j.get("services") or {}).items():
+        if not isinstance(sv, dict) or "image" not in sv:
+            continue
+        ports, hostports = [], {}
+        for p in sv.get("ports") or []:
+            s = str(p).split("/")[0]
+            parts = s.split(":")
+            cp = int(parts[-1])
+            hp = int(parts[-2]) if len(parts) >= 2 and parts[-2] else cp
+            ports.append(cp)
+            hostports[hp] = cp
+        out[service_key(job, name)] = {
+            "image": subst(str(sv["image"]), ctx),
+            "env": {k: subst(str(v), ctx) for k, v in (sv.get("env") or {}).items()},
+            "ports": ports, "hostports": hostports, "orig": name}
+    return out
+
+
+def to_service(s: str, svcs: dict) -> str:
+    for key, sv in svcs.items():
+        for hp, cp in sv["hostports"].items():
+            s = re.sub(rf"\b{LOCAL}:{hp}\b", f"{key}:{cp}", s)
+    return s
+
+
+def chosen_workflows(root: str, g: dict) -> list[str]:
+    wfs = g.get("workflows")
+    if wfs:
+        return list(wfs)
+    d = os.path.join(root, ".github", "workflows")
+    return sorted(os.path.join(".github/workflows", f) for f in os.listdir(d) if f.endswith((".yml", ".yaml"))) \
+        if os.path.isdir(d) else []
+
+
+def unsupported_job(j: dict) -> str:
+    """dagci で同じには流せない job の理由（無ければ空）"""
+    if j.get("uses"):
+        return f"別の workflow を呼ぶ job（uses: {j['uses']}）"
+    ro = j.get("runs-on")
+    ro_s = " ".join(map(str, ro)) if isinstance(ro, list) else str(ro or "")
+    if ro_s and not re.search(r"ubuntu|linux|self-hosted|\$\{\{", ro_s):
+        return f"Linux 以外の台（runs-on: {ro_s}）"
+    if j.get("container"):
+        return "job ごとの容れ物（container:）。道具箱に写すまで流さない"
+    cond = str(j.get("if") or "")
+    if re.search(r"github\.(event\w*|head_ref|base_ref|ref\w*)\b", cond):
+        return f"GitHub の出来事で決まる job（if: {cond.strip()}）"
+    return ""
+
+
+def uses_name(u: str) -> str:
+    return re.sub(r"@.*$", "", u.strip())
+
+
+class Derived:
+    def __init__(self):
+        self.stages: list[dict] = []
+        self.services: dict[str, dict] = {}
+        self.ledger: list[tuple[str, str, str]] = []   # （job/手順, 扱い, 中身）
+        self.fails: list[str] = []
+        self.notes: list[str] = []
+        self.used_skips: set[str] = set()
+
+
+def _slug(text: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:40]
+
+
+def derive(root: str, g: dict | None = None) -> Derived:
+    g = gh_config(root) if g is None else g
+    out = Derived()
+    skip_jobs = g.get("skip_jobs") or {}
+    skip_steps = g.get("skip_steps") or {}
+    ignore_uses = g.get("ignore_uses") or {}
+    setup = [re.compile(p) for p in DEFAULT_SETUP + list(g.get("setup") or [])]
+    job_setup = [re.compile(p) for p in DEFAULT_JOB_SETUP + list(g.get("job_setup") or [])]
+    wfs = chosen_workflows(root, g)
+    if not wfs:
+        out.fails.append("CS6 workflow が無い（.github/workflows/*.yml か github.workflows）")
+    ids: dict[str, int] = {}
+    for wf in wfs:
+        p = os.path.join(root, wf)
+        if not os.path.exists(p):
+            out.fails.append(f"CS6 workflow が無い: {wf}")
+            continue
+        w = load_yaml(p)
+        wenv = {k: str(v) for k, v in (w.get("env") or {}).items()}
+        wdefault = ((w.get("defaults") or {}).get("run") or {})
+        for job, j in (w.get("jobs") or {}).items():
+            if not isinstance(j, dict):
+                continue
+            if job in skip_jobs:
+                out.used_skips.add(f"job:{job}")
+                out.ledger.append((job, "外した job", str(skip_jobs[job])))
+                continue
+            why = unsupported_job(j)
+            if why:
+                out.fails.append(f"CS3 {wf} の job {job}：{why}。段に写せないので skip_jobs に理由を書く")
+                continue
+            mx = first_matrix(j)
+            if mx:
+                out.notes.append(f"{job}：matrix は最初の組だけ（{mx}）")
+            ctx = {"env": dict(wenv), "matrix": mx}
+            ctx["env"].update({k: subst(str(v), ctx) for k, v in (j.get("env") or {}).items()})
+            svcs = job_services(job, j, ctx)
+            out.services.update(svcs)
+            jdefault = {**wdefault, **(((j.get("defaults") or {}).get("run")) or {})}
+            prefix: list[str] = []
+            prev = None
+            steps = j.get("steps") or []
+            for i, st in enumerate(steps):
+                label = str(st.get("name") or st.get("run") or st.get("uses") or f"#{i}").strip().splitlines()[0][:80]
+                key = f"{job}/{label}"
+                if key in skip_steps:
+                    out.used_skips.add(f"step:{key}")
+                    out.ledger.append((key, "外した手順", str(skip_steps[key])))
+                    continue
+                if st.get("uses"):
+                    u = uses_name(str(st["uses"]))
+                    if u in KNOWN_USES:
+                        out.ledger.append((key, "写さない action", KNOWN_USES[u]))
+                    elif u in ignore_uses:
+                        out.used_skips.add(f"uses:{u}")
+                        out.ledger.append((key, "写さない action", str(ignore_uses[u])))
+                    else:
+                        out.fails.append(f"CS1 {job} の手順「{label}」の action {u} を写していない"
+                                         "（道具箱で入れるか、github.ignore_uses に理由を書く）")
+                    continue
+                run = str(st.get("run") or "").strip()
+                if not run:
+                    continue
+                parts = [x.strip() for x in run.split("&&")]
+                if "\n" not in run and ";" not in run and all(any(p.search(x) for p in setup) for x in parts):
+                    out.ledger.append((key, "道具箱・準備で済ませた", run[:100]))
+                    continue
+                sctx = {**ctx, "env": {**ctx["env"], **{k: subst(str(v), ctx) for k, v in (st.get("env") or {}).items()}}}
+                body = to_service(subst(run, sctx), svcs)
+                wd = st.get("working-directory") or jdefault.get("working-directory")
+                multi = "\n" in body
+                if wd:
+                    body = f"cd {shlex.quote(subst(str(wd), sctx))}\n{body}"
+                    multi = True
+                later = any((s.get("run") and not s.get("uses")) for s in steps[i + 1:])
+                if later and (BACKGROUND.search(run) or any(p.search(run) for p in job_setup)):
+                    # 組み立て・立ち上げ：後ろの段の前に毎回流す（段は別の容れ物なので、GitHub の job のように前の手順の結果が残らない）
+                    prefix.append(body if not multi else "bash -eo pipefail -c " + shlex.quote(body))
+                    out.ledger.append((key, "後ろの段の前に流す", run.splitlines()[0][:100]))
+                    continue
+                if prefix:
+                    cmd = " && ".join(prefix + [body if not multi else "bash -eo pipefail -c " + shlex.quote(body)])
+                else:
+                    cmd = "set -eo pipefail\n" + body if multi else body
+                env = {k: to_service(v, svcs) for k, v in sctx["env"].items()}
+                left = sorted({m.group(0) for m in EXPR.finditer(cmd + " ".join(env.values()))})
+                if left:
+                    out.fails.append(f"CS5 {job} の手順「{label}」に dagci が値を知らない式 {left[:3]}"
+                                     f"（skip_steps の \"{key}\" に理由を書くか、命令を変える）")
+                    continue
+                name = str(st.get("name") or run.splitlines()[0])[:120]
+                m = re.match(r"([A-Za-z]{1,3})(\d+)\b", name)
+                sid = f"{job}-{m.group(1).lower()}{int(m.group(2)):02d}" if m else f"{job}-" + (_slug(name) or f"step{i + 1}")
+                if not re.fullmatch(r"[A-Za-z0-9._-]+", sid):
+                    out.fails.append(f"CS2 段の id を作れない: {sid!r}")
+                    continue
+                if sid in ids:   # 同じ名前の手順（別の job の同じ番号は job の名前で分かれる）
+                    ids[sid] += 1
+                    sid = f"{sid}-{ids[sid]}"
+                ids.setdefault(sid, 1)
+                stage = {"id": sid, "name": name, "group": job, "run": cmd}
+                if svcs:
+                    stage["services"] = list(svcs)
+                if env:
+                    stage["env"] = env
+                if svcs and prev:
+                    stage["needs"] = [prev]
+                tm = st.get("timeout-minutes") or j.get("timeout-minutes")
+                if tm:
+                    stage["timeout"] = int(float(tm) * 60)
+                out.stages.append(stage)
+                out.ledger.append((key, "段", sid))
+                prev = sid
+    for kind, table in (("job", skip_jobs), ("step", skip_steps), ("uses", ignore_uses)):
+        for k, why in table.items():
+            if not str(why or "").strip() or "理由を書く" in str(why):
+                out.fails.append(f"CS4 外す記録 {kind} {k} に理由が無い")
+            if f"{kind}:{k}" not in out.used_skips:
+                out.fails.append(f"CS4 外す記録 {kind} {k} が、もう無い物を指している（記録から外す）")
+    if wfs and not out.stages:
+        out.fails.append("CS6 段が 0 本（0 段は緑にしない）")
+    return out
+
+
+def main(argv: list[str] | None = None) -> int:
+    argv = sys.argv[1:] if argv is None else argv
+    root = os.path.abspath(argv[argv.index("--root") + 1]) if "--root" in argv else os.getcwd()
+    d = derive(root)
+    if "--check" in argv:
+        for who, kind, what in d.ledger:
+            print(f"  {kind:<12} {who[:70]:<70} {what[:60]}")
+        for n in d.notes:
+            print("  注:", n)
+        for f in d.fails:
+            print("  ★", f)
+        n_stage = sum(1 for x in d.ledger if x[1] == "段")
+        print(f"段 {n_stage}・相手 {len(d.services)}・済ませた手順 {sum(1 for x in d.ledger if x[1] == '道具箱・準備で済ませた')}・"
+              f"外した物 {sum(1 for x in d.ledger if x[1].startswith('外した'))}")
+        print("FAIL — workflow の手順と dagci の段が 1 対 1 にならない" if d.fails else
+              "PASS — workflow の手順は、どれも段・済ませた手順・理由つきで外した物のどれか 1 つに入っている")
+        return 1 if d.fails else 0
+    if d.fails:
+        for f in d.fails:
+            print("★", f, file=sys.stderr)
+        print("段を導けない（dagci stages --check で一覧を見る）", file=sys.stderr)
+        return 1
+    print(yaml.safe_dump({"stages": d.stages}, allow_unicode=True, sort_keys=False, width=1000))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
