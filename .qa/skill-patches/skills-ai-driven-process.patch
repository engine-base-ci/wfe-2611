+        w("ci/devhost_allow.yaml", "- {path: tests/allowed.test.ts, contains: MOCK_URL, why: 試験の中で立てる口（127.0.0.1 が正しい）}\n")
+        allow_ok = not any("allowed.test.ts" in f for f in Gate(d, {"allow_file": "ci/devhost_allow.yaml"}).check())
+        w("ci/devhost_allow.yaml", "- {path: tests/allowed.test.ts, contains: MOCK_URL}\n- {path: tests/gone.test.ts, contains: x, why: 消えた}\n")
+        f2 = Gate(d, {"allow_file": "ci/devhost_allow.yaml"}).check()
+        h4 = sum(1 for f in f2 if f.startswith("H4")) == 2
+    finally:
+        shutil.rmtree(d, ignore_errors=True)
