+"""dagci smoke — 2 分の健康診断。全部の段（30 分）を流す前に、プロジェクトの外側（道具箱・網・相手）の誤りを見つける。
+
+  dagci smoke            道具箱を作り、容れ物の中で次を 1 項目 1 行の 緑／赤 で出す。赤があれば終わり方 1
+  dagci run --all        最初にこれを流し、赤なら段を流さずに「流せない（健康診断が赤）」で止まる（--no-smoke で外す）
+
+見るもの:
+  道具箱・準備   作れるか（作れなければ、どの命令の何で落ちたか）
+  Python        python3 が venv と見なされているか（sys.prefix）・venv に入れた部品が全部 import できるか
+  Node          node・packageManager の道具と版・package.json の依存が node_modules にあるか
+  https         使う registry（npm・PyPI）に、容れ物の中の curl・node・python3 のそれぞれでつながるか（証明書の読み方が道具ごとに違う）
+  相手          services のどれもが起き、口（TCP）につながるか。postgres の image は pg_isready と select 1、redis は PING
+  smoke         ci.yaml の smoke: に書いたプロジェクトの短い確かめ（例：移行が当たる）
+由来（あるプロジェクト・2026-11-04）：venv の Python・TLS の中継・Chrome・同じ定義の相手・決め打ちの DB は、どれも 30 分流してから 1 つずつ見つかった。
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import time
+
+import anyio
+import dagger
+
+import memo
+import plan as planmod
+
+PG = re.compile(r"postgres|pgvector|postgis|timescale", re.I)
+REDIS = re.compile(r"redis|valkey|keydb", re.I)
+
+
+def record_path(project: str) -> str:
+    return os.path.join(memo.home(), "smoke", f"{project}.json")
+
+
+def _commands(cfg) -> list[dict]:
+    out = []
+    for i, c in enumerate(cfg.raw.get("smoke") or []):
+        if isinstance(c, str):
+            c = {"name": c, "run": c}
+        out.append({"name": str(c.get("name") or c["run"])[:60], "run": str(c["run"]), "services": list(c.get("services") or []),
+                    "env": {k: str(v) for k, v in (c.get("env") or {}).items()}, "timeout": int(c.get("timeout") or 300)})
+    return out
+
+
+def _registries(cfg, files: list[str]) -> list[dict]:
+    regs = []
+    root = cfg.root
+    if "package.json" in files:
+        url = "https://registry.npmjs.org/"
+        npmrc = os.path.join(root, ".npmrc")
+        if os.path.exists(npmrc):
+            m = re.search(r"^\s*registry\s*=\s*(\S+)", open(npmrc, encoding="utf-8").read(), re.M)
+            if m:
+                url = m.group(1)
+        regs.append({"name": "npm", "url": url})
+    env = {**((cfg.raw.get("toolbox") or {}).get("env") or {}), **(cfg.raw.get("env") or {})}
+    py = env.get("VIRTUAL_ENV") or any(re.search(r"(^|/)(requirements[^/]*\.txt|pyproject\.toml)$", f) for f in files)
+    if py:
+        regs.append({"name": "PyPI", "url": str(env.get("PIP_INDEX_URL") or env.get("UV_INDEX_URL") or "https://pypi.org/simple/pip/")})
+    for u in (cfg.raw.get("ci") or {}).get("smoke_urls") or []:
+        regs.append({"name": u.split("/")[2] if "://" in u else u, "url": u})
+    return regs
+
+
+def _service_spec(name: str, sv: dict) -> dict:
+    env = sv.get("env") or {}
+    kind = "postgres" if PG.search(sv["image"]) else ("redis" if REDIS.search(sv["image"]) else "")
+    return {"name": name, "ports": [int(p) for p in sv.get("ports") or []], "kind": kind,
+            "user": env.get("POSTGRES_USER", "postgres"), "password": env.get("POSTGRES_PASSWORD", ""),
+            "db": env.get("POSTGRES_DB") or env.get("POSTGRES_USER") or "postgres"}
+
+
+async def _probe(ctr: dagger.Container, spec: dict, what: str) -> list[dict]:
+    try:
+        done = (ctr.with_env_variable("DAGCI_SMOKE_AT", str(time.time()))   # 毎回本当に確かめる（Dagger に使い回させない）
+                .with_new_file("/ci/smoke.json", json.dumps(spec, ensure_ascii=False))
+                .with_exec(["python3", "/ci/bin/smoke_probe.py", "/ci/smoke.json"], expect=dagger.ReturnType.ANY))
+        out = await done.stdout()
+        rc = await done.exit_code()
+    except dagger.DaggerError as ex:
+        err = (getattr(ex, "stderr", "") or str(ex)).strip().splitlines()
+        return [{"ok": False, "what": what, "msg": f"起こせない: {' / '.join(err[-3:])[:300]}"}]
+    rows = []
+    for line in out.splitlines():
+        try:
+            rows.append(json.loads(line))
+        except ValueError:
+            continue
+    if rc != 0 or not rows:
+        rows.append({"ok": False, "what": what, "msg": f"確かめが終わらない（終わり方 {rc}）: {out[-200:]}"})
+    return rows
+
+
+class SmokeRed(RuntimeError):
+    """run --all の最初の健康診断が赤（段を流さずに「流せない」で止める）"""
+
+
+def save(project: str, rows: list[dict], secs: float) -> bool:
+    ok = bool(rows) and all(r["ok"] for r in rows)
+    os.makedirs(os.path.dirname(record_path(project)), exist_ok=True)
+    json.dump({"at": time.time(), "ok": ok, "rows": rows, "seconds": round(secs)},
+              open(record_path(project), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
+    return ok
+
+
+async def probes(c, r, ws, ready: bool, add) -> None:
+    """作った作業場（ws）の上で、道具・網・相手・smoke の確かめを同時に流す（r は runner.Runner。相手の作り方を同じにする）"""
+    cfg = r.cfg
+    svcs = r.services(c)
+    regs = _registries(cfg, r.o.files)
+    wd = cfg.workdir
+    results: dict[int, list[dict]] = {}
+
+    async def job(i, coro):
+        results[i] = await coro
+
+    async with anyio.create_task_group() as tg:
+        tg.start_soon(job, 0, _probe(ws, {"runtime": True, "registries": regs, "workdir": wd}, "道具"))
+        for i, (name, sv) in enumerate((cfg.raw.get("services") or {}).items(), 1):
+            ctr = ws.with_service_binding(name, svcs[name])
+            tg.start_soon(job, i, _probe(ctr, {"services": [_service_spec(name, sv)], "workdir": wd}, f"相手 {name}"))
+        if ready:
+            for k, cmd in enumerate(_commands(cfg), 100):
+                ctr = ws
+                for n in cmd["services"] or list(svcs):
+                    ctr = ctr.with_service_binding(n, svcs[n])
+                for ek, ev in cmd["env"].items():
+                    ctr = ctr.with_env_variable(ek, ev)
+                tg.start_soon(job, k, _probe(ctr, {"commands": [cmd], "workdir": wd}, f"smoke「{cmd['name']}」"))
+        elif _commands(cfg):
+            results[100] = [{"ok": False, "what": "smoke", "msg": "準備が落ちたので、プロジェクトの確かめは流していない"}]
+    for i in sorted(results):
+        for row in results[i]:
+            add(row)
+
+
+async def _main(cfg, files: list[str], run_dir: str, say) -> list[dict]:
+    from runner import Runner, RunOptions
+    rows: list[dict] = []
+
+    def add(x):
+        rows.append(x)
+        say(x)
+
+    sel = planmod.Selection([], [], {}, [], "smoke")
+    r = Runner(cfg, sel, RunOptions(run_dir=run_dir, files=files, quiet=True))
+    log = open(os.path.join(run_dir, "smoke-engine.log"), "w")
+    async with dagger.Connection(dagger.Config(log_output=log, timeout=120)) as c:
+        t = time.monotonic()
+        try:
+            base = r.toolbox(c)
+            await base.sync()
+            add({"ok": True, "what": "道具箱", "msg": f"作れた（{time.monotonic() - t:.0f} 秒・{(cfg.raw.get('toolbox') or {}).get('from')}）"})
+        except (dagger.DaggerError, ValueError) as ex:
+            err = (getattr(ex, "stderr", "") or str(ex)).strip().splitlines()
+            add({"ok": False, "what": "道具箱", "msg": f"作れない: {' / '.join(err[-3:])[:300]}"})
+            return rows
+        t = time.monotonic()
+        try:
+            ws = r.workspace(c, r.prepare(c, base))
+            await ws.sync()
+            add({"ok": True, "what": "準備・作業場", "msg": f"作れた（{time.monotonic() - t:.0f} 秒・準備 {len(cfg.raw.get('prepare') or [])} 本）"})
+            ready = True
+        except dagger.DaggerError as ex:
+            err = (getattr(ex, "stderr", "") or str(ex)).strip().splitlines()
+            add({"ok": False, "what": "準備・作業場", "msg": f"作れない: {' / '.join(err[-3:])[:300]}"})
+            ws, ready = base, False
+        await probes(c, r, ws, ready, add)
+    log.close()
+    return rows
+
+
+def check(cfg, files: list[str], run_dir: str, quiet: bool = False) -> tuple[bool, list[dict], float]:
+    os.makedirs(run_dir, exist_ok=True)
+
+    def say(r):
+        if not quiet:
+            print(f"  {'緑' if r['ok'] else '赤'}  {r['what']}：{r['msg']}", flush=True)
+    t = time.monotonic()
+    rows = anyio.run(_main, cfg, files, run_dir, say)
+    secs = time.monotonic() - t
+    return save(cfg.project, rows, secs), rows, secs
+
+
+def run(cfg, a) -> int:
+    from main import disk_ready, engine_ready
+    files = planmod.workspace_files(cfg.root)
+    run_dir = os.path.join(memo.home(), "runs", cfg.project, time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}-smoke")
+    print(f"dagci smoke：{cfg.project}（道具箱・部品・網・相手・smoke の確かめ）", flush=True)
+    try:
+        disk_ready(cfg)
+        engine_ready()
+    except RuntimeError as ex:
+        print(f"  赤  流せない：{ex}")
+        return 3
+    ok, rows, secs = check(cfg, files, run_dir)
+    reds = sum(1 for r in rows if not r["ok"])
+    print(f"dagci smoke：{'緑' if ok else '赤'}（緑 {len(rows) - reds}・赤 {reds}・{secs:.0f} 秒）")
+    return 0 if ok else 1
