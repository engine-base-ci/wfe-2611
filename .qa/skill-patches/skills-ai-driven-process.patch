-                    if env is not None and (env.get("DAGCI_TRACE_DIR") or env.get(b"DAGCI_TRACE_DIR")) is None:
-                        _emit("p", "python-without-trace-env")
-            elif event in ("os.system", "os.exec", "os.posix_spawn", "os.spawn", "os.fork"):
