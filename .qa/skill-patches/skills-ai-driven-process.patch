+"""workflow から段を導く（stages_from_github）と、ci.yaml の下書き（init_ci）の検査。容れ物も網も使わない。
+   流し方: python3 -m unittest discover -s scripts/ci/dagci/tests   （PyYAML が要る）
+"""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import textwrap
+import types
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(HERE))
+
+import yaml  # noqa: E402
+
+import config  # noqa: E402
+import init_ci  # noqa: E402
+import stages_from_github as sg  # noqa: E402
+
+WF = """
+name: ci
+on: {push: {branches: [main]}, pull_request: {}}
+env: {NODE_VERSION: '22'}
+jobs:
+  static:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: '3.12'}
+      - run: pip install pyyaml
+      - name: G1 config check
+        run: python3 check.py
+  test:
+    runs-on: ubuntu-latest
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env: {POSTGRES_PASSWORD: pw, POSTGRES_DB: app}
+        ports: ['5432:5432']
+    env:
+      DATABASE_URL: postgres://postgres:pw@localhost:5432/app
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with: {node-version: '${{ env.NODE_VERSION }}'}
+      - run: npm ci
+      - run: npm run build
+      - name: G2 unit
+        run: npm test
+      - name: G3 db
+        run: |
+          echo one
+          npm run test:db
+  other:
+    runs-on: ubuntu-latest
+    if: github.event_name == 'pull_request'
+    steps:
+      - run: echo "${{ github.head_ref }}"
+"""
+RELEASE = "name: r\non: {release: {types: [published]}}\njobs:\n  p: {runs-on: ubuntu-latest, steps: [{run: echo}]}\n"
+
+
+def project(d: str, wf: str = WF) -> None:
+    os.makedirs(os.path.join(d, ".github/workflows"))
+    open(os.path.join(d, ".github/workflows/ci.yml"), "w").write(textwrap.dedent(wf))
+    open(os.path.join(d, ".github/workflows/release.yml"), "w").write(RELEASE)
+    open(os.path.join(d, "package.json"), "w").write(json.dumps({"name": "x", "dependencies": {"pg": "8.13.1"}}))
+    open(os.path.join(d, "package-lock.json"), "w").write("{}")
+
+
+class StagesTest(unittest.TestCase):
+    def test_derive(self):
+        with tempfile.TemporaryDirectory() as d:
+            project(d)
+            g = {"workflows": [".github/workflows/ci.yml"], "skip_jobs": {"other": "PR だけ"}}
+            r = sg.derive(d, g)
+            self.assertEqual(r.fails, [])
+            by = {s["id"]: s for s in r.stages}
+            self.assertEqual(list(by), ["static-g01", "test-g02", "test-g03"])
+            self.assertEqual(list(r.services), ["test-postgres"])                  # job ごとの名前
+            self.assertEqual(by["test-g02"]["env"]["DATABASE_URL"], "postgres://postgres:pw@test-postgres:5432/app")
+            self.assertTrue(by["test-g02"]["run"].startswith("npm run build && "))  # 組み立ては後ろの段の前に
+            self.assertEqual(by["test-g03"]["needs"], ["test-g02"])                 # 相手のある job は順に
+            self.assertIn("-eo pipefail", by["test-g03"]["run"])                 # 複数行は GitHub と同じく
+            self.assertNotIn("services", by["static-g01"])
+
+    def test_reds(self):
+        with tempfile.TemporaryDirectory() as d:
+            project(d, WF.replace("      - run: npm ci\n", "      - run: npm ci\n      - uses: docker/build-push-action@v6\n"))
+            r = sg.derive(d, {"workflows": [".github/workflows/ci.yml"], "skip_jobs": {"gone": "x", "nobody": ""}})
+            codes = sorted(f.split()[0] for f in r.fails)
+            self.assertIn("CS1", codes)   # 知らない action
+            self.assertIn("CS3", codes)   # if: の job が skip_jobs に無い
+            self.assertGreaterEqual(codes.count("CS4"), 3)   # もう無い物を指す・理由が無い
+            r = sg.derive(d, {"workflows": [".github/workflows/ci.yml"], "skip_jobs": {"other": "x"},
+                              "skip_steps": {}, "ignore_uses": {"docker/build-push-action": "image は作らない"}})
+            self.assertEqual(r.fails, [])
+
+    def test_secrets_left(self):
+        with tempfile.TemporaryDirectory() as d:
+            project(d, WF.replace("run: npm test", "run: TOKEN=${{ secrets.T }} npm test"))
+            r = sg.derive(d, {"workflows": [".github/workflows/ci.yml"], "skip_jobs": {"other": "x"}})
+            self.assertTrue(any(f.startswith("CS5") for f in r.fails))
+
+
+class InitTest(unittest.TestCase):
+    def test_init_writes_loadable_config(self):
+        with tempfile.TemporaryDirectory() as d:
+            project(d)
+            subprocess.run(["git", "init", "-q"], cwd=d)
+            rc = init_ci.run(types.SimpleNamespace(root=d, workflow=None, out=None, force=False, offline=True))
+            self.assertEqual(rc, 0)
+            raw = yaml.safe_load(open(os.path.join(d, "ci.yaml")))
+            self.assertEqual(raw["github"]["workflows"], [".github/workflows/ci.yml"])   # release は外す
+            self.assertIn("other", raw["github"]["skip_jobs"])
+            self.assertEqual(raw["toolbox"]["from"], "node:22-bookworm")                # 網なし：書いてあるまま
+            env = raw["toolbox"]["env"]
+            for k in ("NODE_EXTRA_CA_CERTS", "SSL_CERT_FILE", "UV_NATIVE_TLS"):
+                self.assertIn(k, env)
+            self.assertTrue(env["PATH"].startswith("/opt/py/bin:"))
+            self.assertTrue(any("sys.prefix" in x for x in raw["toolbox"]["steps"]))
+            self.assertTrue(any("postgresql-client" in x for x in raw["toolbox"]["steps"]))
+            self.assertIn("test-postgres", raw["services"])
+            self.assertIn("npm ci", raw["prepare"][0]["run"])
+            os.environ["DAGCI_PY"], os.environ["DAGCI_LIB"] = sys.executable, os.path.dirname(HERE)
+            cfg = config.load(os.path.join(d, "ci.yaml"))                               # include の命令で段が出る
+            self.assertEqual([s.id for s in cfg.stages], ["static-g01", "test-g02", "test-g03"])
+            # 2 回目は上書きしない
+            init_ci.run(types.SimpleNamespace(root=d, workflow=None, out=None, force=False, offline=True))
+            self.assertTrue(os.path.exists(os.path.join(d, "ci.init.yaml")))
+
+
+if __name__ == "__main__":
+    unittest.main()
