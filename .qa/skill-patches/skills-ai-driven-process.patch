-def code_fingerprint() -> str:
-    h = hashlib.sha256()
-    for root in (HERE, os.path.join(HERE, "incontainer"), os.path.dirname(os.path.dirname(HERE))):
-        for f in sorted(os.listdir(root)):
-            p = os.path.join(root, f)
-            if os.path.isfile(p) and (f.endswith((".py", ".sh")) or f == "dagci"):
-                h.update(f.encode() + open(p, "rb").read())
-    return h.hexdigest()[:16]
