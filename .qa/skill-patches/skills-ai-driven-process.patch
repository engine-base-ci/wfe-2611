diff -ruN orig/test-verification/scripts/pattern_gate.py new/test-verification/scripts/pattern_gate.py
--- orig/test-verification/scripts/pattern_gate.py	1970-01-01 00:00:00.000000000 +0000
+++ new/test-verification/scripts/pattern_gate.py	2026-11-04 13:26:49.036127380 +0000
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""チケットが、自分の分類のテストの型を全部受けているか（書いていない＝漏れ）。
+
+  python3 <skill>/scripts/pattern_gate.py <チケットの .md ...> [--local <test-patterns.local.json>]
+  python3 <skill>/scripts/pattern_gate.py --selftest
+
+チケットの書き方:
+  - 「分類:」の行に分類の ID を書く（例 `分類: REG, MAIL`）。分類の ID は patterns.json の categories
+  - その分類の型の ID（例 TP-REG-02）を、テストの表の行に書くか、「要らない: TP-REG-05 理由」と書く
+赤になるもの:
+  P1 分類の行が無い・知らない分類
+  P2 その分類の型の ID が、テストにも「要らない」にも無い（書いていない＝漏れ）
+  P3 「要らない」に理由が無い
+"""
+from __future__ import annotations
+import json, os, re, sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from build_test_patterns import load  # noqa: E402
+
+
+def check(text: str, d: dict) -> list[str]:
+    m = re.search(r"^[\s|*-]*分類[\s*|]*[:：|]\s*([A-Z0-9_ ,、・]+)", text, re.M)
+    if not m:
+        return ["P1 「分類:」の行が無い（例 `分類: REG, MAIL`）"]
+    cats = [c for c in re.split(r"[ ,、・]+", m.group(1).strip()) if c]
+    fails = [f"P1 知らない分類 {c}" for c in cats if c not in d["categories"]]
+    for p in d["patterns"]:
+        if p["category"] not in cats:
+            continue
+        lines = [ln for ln in text.splitlines() if p["id"] in ln]
+        if not lines:
+            fails.append(f"P2 {p['id']}（{p['branch']}）が、テストにも「要らない」にも無い")
+            continue
+        for ln in lines:
+            r = re.search(r"要らない\s*[:：]\s*" + re.escape(p["id"]) + r"\s*(.*)", ln)
+            if r and len(r.group(1).strip(" |。")) < 4:
+                fails.append(f"P3 {p['id']} を要らないとした理由が無い")
+    return fails
+
+
+def main() -> int:
+    local = sys.argv[sys.argv.index("--local") + 1] if "--local" in sys.argv else None
+    d = load(local)
+    if "--selftest" in sys.argv:
+        t = {"categories": {"X": "x"}, "patterns": [{"id": "TP-X-01", "category": "X", "branch": "a"}, {"id": "TP-X-02", "category": "X", "branch": "b"}, {"id": "TP-X-03", "category": "X", "branch": "c"}]}
+        ok = (any(f.startswith("P1") for f in check("本文", t))
+              and any("TP-X-02" in f and f.startswith("P2") for f in check("分類: X\n| TP-X-01 | テスト |\n要らない: TP-X-03 外の会社に無い機能のため", t))
+              and any(f.startswith("P3") for f in check("分類: X\n| TP-X-01 |\n| TP-X-02 |\n要らない: TP-X-03", t))
+              and not check("分類: X\n| TP-X-01 |\n| TP-X-02 |\n要らない: TP-X-03 この画面は一覧を持たない", t)
+              and any("知らない分類" in f for f in check("分類: Y", t)))
+        print("PASS — 分類の行が無い・型の書き漏れ・理由の無い要らない・知らない分類を赤にした" if ok else "FAIL — 見つけられない")
+        return 0 if ok else 1
+    files = [a for a in sys.argv[1:] if not a.startswith("--") and a != local]
+    bad = 0
+    for f in files:
+        fs = check(open(f, encoding="utf-8").read(), d)
+        for x in fs:
+            print(f"  ★ {f}: {x}")
+        bad += bool(fs)
+    print(f"チケット {len(files)}・型 {len(d['patterns'])}")
+    print("FAIL — 型を受けていないチケットがある" if bad else "PASS — どのチケットも、自分の分類の型を全部受けている")
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
