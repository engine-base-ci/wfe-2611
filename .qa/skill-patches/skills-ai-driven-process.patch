-def simulate(stages, dur: dict, jobs: int) -> float:
-    """依存の順と同時に流す数（jobs）を守ったときの、終わるまでの時間（貪欲に空いた枠へ）"""
-    ids = {s.id for s in stages}
-    end: dict[str, float] = {}
-    slots = [0.0] * max(1, jobs)
-    for s in stages:   # 依存の順に並んでいる
-        ready = max([end[n] for n in s.needs if n in ids] or [0.0])
-        if s.mutates:          # 書き換える段の鎖は 1 本ずつ
-            start = ready
-        else:
-            slots.sort()
-            start = max(slots[0], ready)
-            slots[0] = start + dur.get(s.id, 0.0)
-        end[s.id] = start + dur.get(s.id, 0.0)
-    return max(end.values() or [0.0])
-
-
-def split(cfg, stages, dur: dict, n: int) -> list[list]:
-    chain = [s for s in stages if s.mutates]
-    rest = sorted([s for s in stages if not s.mutates], key=lambda s: -dur.get(s.id, 0.0))
-    bins = [[] for _ in range(n)]
-    load = [0.0] * n
-    for s in rest:   # 長い段から、いちばん空いている台へ（LPT）
-        i = load.index(min(load))
-        bins[i].append(s)
-        load[i] += dur.get(s.id, 0.0)
-    order = {s.id: k for k, s in enumerate(stages)}
-    return [sorted(chain + b, key=lambda s: order[s.id]) for b in bins]
-
