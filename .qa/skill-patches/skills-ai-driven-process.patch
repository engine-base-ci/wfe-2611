-
-    def _rel(path):
-        if isinstance(path, int) or path is None:
-            return None
-        try:
-            p = os.fsdecode(path)
-        except Exception:
-            return None
-        p = os.path.normpath(os.path.join(os.getcwd(), p)) if not os.path.isabs(p) else os.path.normpath(p)
-        if p == _ROOT:
-            return "."
-        if not p.startswith(_PREFIX):
-            return None
-        return p[len(_PREFIX):]
-
-    def _read(kind, path):
-        r = _rel(path)
-        if r is not None and r not in _written:
-            _emit(kind, r)
-
-    def _write(path):
-        r = _rel(path)
-        if r is not None:
-            _written.add(r)
-            _emit("w", r)
