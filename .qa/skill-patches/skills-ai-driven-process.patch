--- orig/ai-team-delivery/scripts/gates/deps_gate.py	1970-01-01 00:00:00.000000000 +0000
+++ new/ai-team-delivery/scripts/gates/deps_gate.py	2026-11-05 01:00:16.553509134 +0000
@@ -0,0 +1,222 @@
+#!/usr/bin/env python3
+"""部品（依存）の版の検査（標準の検査・あるプロジェクトの G46 の S4〜S6 から汎用にした）。設定は ci-gates.yaml の deps:。
+
+  python3 <skill>/scripts/gates/deps_gate.py [--root <根>] [--config <ci-gates.yaml>]
+  python3 <skill>/scripts/gates/deps_gate.py --selftest    手で作った lockfile と出た日で、赤にすべき物を赤にできるか
+
+読む lockfile：pnpm-lock.yaml（pnpm）・package-lock.json（npm v2/v3）。今は npm の部品（Node）だけを見る。
+赤になるもの:
+  D1 上流が「非推奨」にした部品が、記録（baseline）に無い（直すか、記録にチケットと理由つきで書く）
+  D2 記録の部品が、もう lockfile に無い（記録から外す）
+  D3 lockfile の版が、出てから min_age_days 日を過ぎていない（例外に「名前@版」と出た日が無い）。出た日は registry に聞く
+     ★CI の install は lockfile のまま解き直さない（pnpm install --frozen-lockfile・npm ci）ので、パッケージマネージャの
+       「出て N 日未満の版を選ばない」設定は、lockfile にすでに入った若い版を止めない。ここで止める
+  D4 pnpm なのに pnpm-workspace.yaml に minimumReleaseAge（min_age_days 日以上）が無い（require_pm_setting: true のとき）
+  D5 例外の書き方が違う（「名前@版」でない・出た日（YYYY-MM-DD）が無い）。過ぎた例外は知らせるだけ（外してよい）
+registry に聞けない部品は赤にする（黙って通さない）。手元で網が無いときだけ --offline（D3 を飛ばすと出す）。
+
+設定（ci-gates.yaml）:
+  deps:
+    min_age_days: 21               # 出てから何日を過ぎた版だけを使うか（0 で D3・D4 を見ない）
+    baseline: ci/deprecated_baseline.json   # {"entries": {"名前@版": {"ticket": ..., "why": ...}}}
+    age_exclude: []                # 例外 ["名前@版 # 2026-11-01 に出た・理由"]。pnpm の minimumReleaseAgeExclude も読む
+    require_pm_setting: true       # pnpm のとき minimumReleaseAge を必須にする
+    registry: https://registry.npmjs.org
+"""
+from __future__ import annotations
+import concurrent.futures, datetime, json, os, re, shutil, ssl, sys, tempfile, urllib.parse, urllib.request
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from _common import config, not_used, root_from_args  # noqa: E402
+
+NOTES: list[str] = []
+
+
+# ---- lockfile を読む（名前@版 → 非推奨の文 or None）
+def read_pnpm(text: str) -> dict[str, str | None]:
+    if "\npackages:\n" not in text:
+        return {}
+    sec = text[text.index("\npackages:\n"):]
+    sec = sec[:sec.index("\nsnapshots:\n")] if "\nsnapshots:\n" in sec else sec
+    out: dict[str, str | None] = {}
+    for blk in re.split(r"\n(?=  \S)", sec):
+        m = re.match(r"  '?(@?[^@\s']+)@([^\s'(:]+)", blk)
+        if m:
+            d = re.search(r"\n    deprecated: (.*)", blk)
+            out[f"{m.group(1)}@{m.group(2)}"] = d.group(1).strip().strip("'\"") if d else None
+    return out
+
+
+def read_npm(text: str) -> dict[str, str | None]:
+    j = json.loads(text)
+    out: dict[str, str | None] = {}
+    for k, v in (j.get("packages") or {}).items():
+        if not k or v.get("link") or "version" not in v or "node_modules/" not in k:
+            continue
+        name = v.get("name") or k.rsplit("node_modules/", 1)[1]
+        out[f"{name}@{v['version']}"] = v.get("deprecated")
+    return out
+
+
+def lock(root: str) -> tuple[str, dict[str, str | None]]:
+    for f, fn in (("pnpm-lock.yaml", read_pnpm), ("package-lock.json", read_npm)):
+        p = os.path.join(root, f)
+        if os.path.exists(p):
+            return f, fn(open(p, encoding="utf-8").read())
+    return "", {}
+
+
+def split(nv: str) -> tuple[str, str]:
+    i = nv.rindex("@")
+    return nv[:i], nv[i + 1:]
+
+
+# ---- 例外（名前@版・出た日）
+def excludes(root: str, cfg: dict) -> list[tuple[str, str]]:
+    lines = [str(x) for x in cfg.get("age_exclude") or []]
+    ws = os.path.join(root, "pnpm-workspace.yaml")
+    if os.path.exists(ws):
+        blk = re.search(r"^minimumReleaseAgeExclude:(.*?)(?=^\S|\Z)", open(ws, encoding="utf-8").read(), re.M | re.S)
+        lines += [ln.strip()[1:].strip() for ln in (blk.group(1).splitlines() if blk else []) if ln.strip().startswith("-")]
+    out = []
+    for ln in lines:
+        m = re.match(r'^"?([^"\s#]+)"?\s*(#.*)?$', ln)
+        if m:
+            out.append((m.group(1), m.group(2) or ""))
+    return out
+
+
+def check_excludes(ex: list[tuple[str, str]], days: int, today: datetime.date) -> list[str]:
+    fails = []
+    for name, note in ex:
+        if not re.search(r".+@\d", name):
+            fails.append(f"D5 例外 {name} は「名前@版」で書く（名前だけだと、どの版でも通ってしまう）")
+        d = re.search(r"(\d{4}-\d{2}-\d{2})", note)
+        if not d:
+            fails.append(f"D5 例外 {name} に出た日（YYYY-MM-DD）が無い（いつ外せるかわからない）")
+        elif datetime.date.fromisoformat(d.group(1)) + datetime.timedelta(days=days) < today:
+            NOTES.append(f"例外 {name} は出て {days} 日を過ぎた（{d.group(1)}）。外してよい")
+    return fails
+
+
+def check_pm_setting(root: str, days: int) -> list[str]:
+    ws = os.path.join(root, "pnpm-workspace.yaml")
+    t = open(ws, encoding="utf-8").read() if os.path.exists(ws) else ""
+    m = re.search(r"^minimumReleaseAge:\s*(\d+)", t, re.M)
+    if not m or int(m.group(1)) < days * 1440:
+        return [f"D4 pnpm-workspace.yaml に minimumReleaseAge（{days * 1440} 分＝{days} 日以上）が無い（解き直すとき若い版を選ばせない）"]
+    return []
+
+
+# ---- 非推奨
+def check_deprecated(pk: dict[str, str | None], base: dict) -> list[str]:
+    now = {k: v for k, v in pk.items() if v}
+    fails = [f"D1 上流が非推奨にした部品 {k}（{v[:120]}）。直すか、記録にチケットと理由つきで書く" for k, v in sorted(now.items()) if k not in base]
+    fails += [f"D2 記録の {k} はもう lockfile に無い（記録から外す）" for k in sorted(base) if k not in pk]
+    return fails
+
+
+# ---- 出た日
+def registry_times(names: list[str], registry: str) -> dict[str, dict]:
+    ca = os.environ.get("SSL_CERT_FILE") or os.environ.get("REQUESTS_CA_BUNDLE") or os.environ.get("NODE_EXTRA_CA_CERTS")
+    ctx = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()
+
+    def one(name: str) -> tuple[str, dict]:
+        u = registry.rstrip("/") + "/" + urllib.parse.quote(name, safe="@")
+        err = ""
+        for _ in range(3):
+            try:
+                with urllib.request.urlopen(urllib.request.Request(u, headers={"accept": "application/json"}), context=ctx, timeout=60) as r:
+                    return name, json.load(r).get("time", {})
+            except Exception as e:  # noqa: BLE001 — 聞けなければ赤にする
+                err = str(e)
+        return name, {"_err": err}
+
+    with concurrent.futures.ThreadPoolExecutor(16) as ex:
+        return dict(ex.map(one, names))
+
+
+def check_age(pk: dict, times: dict, ex_names: set[str], days: int, now: datetime.datetime) -> list[str]:
+    cut = now - datetime.timedelta(days=days)
+    fails = []
+    for nv in sorted(pk):
+        n, v = split(nv)
+        tm = times.get(n, {})
+        if "_err" in tm:
+            fails.append(f"D3 {n} の出た日を registry に聞けない（{tm['_err'][:80]}）")
+            continue
+        ts = tm.get(v)
+        if not ts:
+            fails.append(f"D3 {nv} の出た日が registry に無い")
+            continue
+        if datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")) > cut and nv not in ex_names:
+            fails.append(f"D3 {nv} は {ts[:10]} に出て {days} 日を過ぎていない（過ぎた版に解き直すか、例外に「名前@版」と出た日を書く）")
+    return fails
+
+
+def run(root: str, cfg: dict, offline: bool) -> int:
+    days = int(cfg.get("min_age_days", 21))
+    kind, pk = lock(root)
+    if not kind:
+        print("PASS — npm の lockfile（pnpm-lock.yaml・package-lock.json）が無い（見る物が無い）")
+        return 0
+    bp = os.path.join(root, cfg.get("baseline") or "ci/deprecated_baseline.json")
+    base = (json.load(open(bp, encoding="utf-8")).get("entries") or {}) if os.path.exists(bp) else {}
+    fails = check_deprecated(pk, base)
+    if days > 0:
+        ex = excludes(root, cfg)
+        fails += check_excludes(ex, days, datetime.date.today())
+        if kind == "pnpm-lock.yaml" and cfg.get("require_pm_setting", True):
+            fails += check_pm_setting(root, days)
+        if offline:
+            NOTES.append("--offline：D3（出た日）を飛ばした。CI では必ず網つきで流す")
+        else:
+            names = sorted({split(nv)[0] for nv in pk})
+            times = registry_times(names, cfg.get("registry") or "https://registry.npmjs.org")
+            fails += check_age(pk, times, {n for n, _ in ex}, days, datetime.datetime.now(datetime.timezone.utc))
+    for n in NOTES:
+        print("  note", n)
+    for f in fails:
+        print("  ★", f)
+    print(f"{kind}：部品 {len(pk)} 個（非推奨 {sum(1 for v in pk.values() if v)}・記録 {len(base)}）")
+    print("FAIL — 部品の版に直す所がある" if fails else f"PASS — 非推奨は記録どおり・どの版も出て {days} 日を過ぎている（例外を除く）")
+    return 1 if fails else 0
+
+
+def selftest() -> int:
+    pn = ("lockfileVersion: '9.0'\n\npackages:\n\n  young@1.0.0:\n    resolution: {integrity: x}\n\n"
+          "  '@s/old@2.0.0':\n    resolution: {integrity: x}\n    deprecated: no longer supported\n\nsnapshots:\n\n  young@1.0.0: {}\n")
+    pk = read_pnpm(pn)
+    npm = read_npm(json.dumps({"lockfileVersion": 3, "packages": {"": {"name": "app"},
+                   "node_modules/a": {"version": "1.0.0"}, "node_modules/b/node_modules/@c/d": {"version": "2.0.0", "deprecated": "x"}}}))
+    times = {"young": {"1.0.0": "2026-01-25T00:00:00Z"}, "@s/old": {"2.0.0": "2025-01-01T00:00:00Z"}}
+    now = datetime.datetime(2026, 2, 1, tzinfo=datetime.timezone.utc)
+    r_read = pk == {"young@1.0.0": None, "@s/old@2.0.0": "no longer supported"} and npm == {"a@1.0.0": None, "@c/d@2.0.0": "x"}
+    r1 = any(f.startswith("D1") and "@s/old@2.0.0" in f for f in check_deprecated(pk, {}))
+    r1ok = not check_deprecated(pk, {"@s/old@2.0.0": {}})
+    r2 = any(f.startswith("D2") for f in check_deprecated(pk, {"@s/old@2.0.0": {}, "gone@1.0.0": {}}))
+    a = check_age(pk, times, set(), 21, now)
+    r3 = len(a) == 1 and "young@1.0.0" in a[0] and not check_age(pk, times, {"young@1.0.0"}, 21, now)
+    r3err = any("聞けない" in f for f in check_age(pk, {"young": {"_err": "x"}, "@s/old": times["@s/old"]}, set(), 21, now))
+    r5 = any("「名前@版」" in f for f in check_excludes([("young", "# 2026-01-25")], 21, now.date())) and \
+        any("出た日" in f for f in check_excludes([("young@1.0.0", "")], 21, now.date()))
+    d = tempfile.mkdtemp(prefix="deps-gate-selftest-")
+    try:
+        open(os.path.join(d, "pnpm-workspace.yaml"), "w").write("minimumReleaseAge: 1440\n")
+        r4 = bool(check_pm_setting(d, 21))
+        open(os.path.join(d, "pnpm-workspace.yaml"), "w").write("minimumReleaseAge: 30240\n")
+        r4ok = not check_pm_setting(d, 21)
+    finally:
+        shutil.rmtree(d, ignore_errors=True)
+    ok = all([r_read, r1, r1ok, r2, r3, r3err, r4, r4ok, r5])
+    print("PASS — 読み取り・記録に無い非推奨・消えた記録・若い版・聞けない部品・設定の外れ・例外の書き方を見つけた" if ok else
+          f"FAIL — 見つけられない（読む {r_read}・D1 {r1}/{r1ok}・D2 {r2}・D3 {r3}/{r3err}・D4 {r4}/{r4ok}・D5 {r5}）")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    if "--selftest" in sys.argv:
+        sys.exit(selftest())
+    root = root_from_args()
+    c = config(root, "deps")
+    sys.exit(not_used("deps") if c is None else run(root, c, "--offline" in sys.argv))
