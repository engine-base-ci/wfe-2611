-                  ensure_ascii=False)
-        print()
-        return 0
-    one = simulate(stages, dur, jobs)
-    chain = sum(dur.get(s.id, 0.0) for s in stages if s.mutates)
-    longest = max(((dur.get(s.id, 0.0), s.name) for s in stages if not s.mutates), default=(0, ""))
