+#!/usr/bin/env bash
+# act_ci.sh — GitHub と同じ workflow（.github/workflows）を、GitHub を通さずに手元で act で流す（ずっと無料）。
+#   使い方: act_ci.sh [<コミット>] [-- <act に渡す引数>]
+#     <コミット> を省くと HEAD。そのコミットを、まっさらな git の写しに取り出してから流す（GitHub の取り出しと同じ条件：
+#     手元の未コミットの変更・別の作業場所・node_modules を混ぜない）。コミットしてから流すこと（生成物が最新かの検査が
+#     「コミット済みと同じか」を見るため）
+#   プロジェクトの設定は根の .act-ci.env（1 行 1 つ・例 ACT_WORKFLOW=.github/workflows/pr-gate.yml・ACT_EVENT=pull_request）。
+#     チケットの CI で流すのは PR の門にあたる workflow だけにする（リリースの前の検査などを混ぜない）
+#   台ごとの設定（台の像・証明書・部品の写し・同時に流す数）は act が自分で読む ~/.actrc か、根の .actrc に書く。
+#     workflow とこの台本は台ごとに変えない（references/ci.md「台ごとの設定」）
+#   終わり方: act の終わり方（0 = 全部の組が緑）
+set -euo pipefail
+ROOT=$(git rev-parse --show-toplevel)
+REV=HEAD
+if [ $# -gt 0 ] && [ "$1" != "--" ]; then REV=$1; shift; fi
+[ "${1:-}" = "--" ] && shift
+SHA=$(git -C "$ROOT" rev-parse "$REV^{commit}")
+# プロジェクトの設定（流す workflow と出来事）。そのコミットの .act-ci.env を読む
+if git -C "$ROOT" cat-file -e "$SHA:.act-ci.env" 2>/dev/null; then
+  eval "$(git -C "$ROOT" show "$SHA:.act-ci.env" | grep -E '^(ACT_WORKFLOW|ACT_EVENT)=[A-Za-z0-9_./-]+$' | sed 's/^/export /')"
+fi
+EVENT=${ACT_EVENT:-workflow_dispatch}
+WF=${ACT_WORKFLOW:-.github/workflows}
+WORK=$(mktemp -d "${TMPDIR:-/tmp}/act-ci-XXXXXX")
+trap 'rm -rf "$WORK"' EXIT
+git clone -q "$ROOT" "$WORK/src"
+git -C "$WORK/src" checkout -q --detach "$SHA"
+echo "act_ci: ${SHA:0:10} を まっさらな写しで流す（$EVENT・$WF）" >&2
+cd "$WORK/src"
+set +e
+act "$EVENT" -W "$WF" "$@"
+rc=$?
+set -e
+docker ps -aq --filter name=act- | xargs -r docker rm -f >/dev/null 2>&1 || true
+echo "act_ci: 終わり方 $rc（${SHA:0:10}）" >&2
+exit $rc
