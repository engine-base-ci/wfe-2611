+# ci-gates.yaml — 標準の検査（<skill>/scripts/gates/）の設定。プロジェクトの根に置く。使わない検査は節ごと消す（消した検査は「使っていない」で緑）。
+# どれも「わざと壊すと赤になる」自己試験（--selftest）を持つ。CI の段に、自己試験と本体の両方を入れる（references/ci.md §「標準の検査」）。
+# ↓ のパス・命令は例。プロジェクトのものに書き換える
+
+# 生成物が最新か：作り手を全部回し、コミットされている生成物が変わったら赤。目録に無い生成物（先頭 3 行に印）も赤
+generated:
+  generators:                       # 上から順に回す（前の出力を次が読むなら、その順）
+    - name: API の型
+      run: npm run -s codegen
+      outputs: [src/api/types.ts]
+  known_stale: []                   # [{path: ..., ticket: ...}] 古いのを知っていて後で直すもの（直ったら外す）
+  not_generated: []                 # [{path: ..., why: ...}] 印が付いているが生成物ではない
+  elsewhere: []                     # [{outputs: [glob], by: 別の検査}] 別の検査が最新かを見ている生成物
+
+# 書いた検査が CI から回っているか：検査の台本・package.json の ci:*・自己試験が CI の設定に出てこなければ赤
+wiring:
+  ci_files: [.github/workflows/*.yml, ci.yaml]
+  stage_cmds: []                    # ci.yaml の include のように、段の一覧を命令で出しているなら、その命令
+  checks: [scripts/ci/*.py, scripts/ci/*.mjs, scripts/ci/*.sh]
+  package_scripts: "ci:"
+  selftest_flag: "--selftest"
+  exceptions: {}                    # {名前: 回さない理由}（作り手・手元で回す道具）
+  known_broken: {}                  # {名前: チケット}（直ったら赤で知らせる）
+
+# 部品の版：上流の非推奨は記録どおりか・lockfile のどの版も出て N 日を過ぎたか（npm の部品・pnpm と npm の lockfile）
+deps:
+  min_age_days: 21                  # 0 にすると出た日を見ない
+  baseline: ci/deprecated_baseline.json   # {"entries": {"名前@版": {"ticket": "...", "why": "..."}}}
+  age_exclude: []                   # ["名前@版 # 2026-11-01 に出た・弱点の直しで急ぐ"]（pnpm の minimumReleaseAgeExclude も読む）
+  require_pm_setting: true          # pnpm なら minimumReleaseAge を必須にする
+
+# テストが開発者の台を決め打ちしていないか：テストとテストの手伝いのファイルで、環境の値が無いときに手元の接続先へ落ちる形
+#   （process.env.DATABASE_URL ?? "postgres://…127.0.0.1:55433/…"・|| 'localhost:5432'・os.environ.get("X", "redis://localhost:6379")・${X:-localhost:5432}）、
+#   環境から来た URL の口だけを書き換える形（u.port = …・.replace(":5432", …)）、決め打ちの手元の DB の URL を ファイル:行 で赤にする。
+#   CI の相手は 127.0.0.1 ではない（容れ物の名前）。値が無ければ止める（throw・os.environ["X"]・${X:?}）（あるプロジェクト・2026-11-04）
+devhost:
+  tests: ["**/*.test.*", "**/*.spec.*", "**/test/**", "**/tests/**", "**/__tests__/**", "**/test_*.py", "**/*_test.py",
+          "**/conftest.py", "**/vitest.config.*", "**/jest.config.*", "**/playwright.config.*", "**/test-utils/**", "**/testing/**"]
+  exclude: []                       # 足して外す glob（node_modules・dist・build は最初から外す）
+  allow_file: ci/devhost_allow.yaml # [{path: glob, contains: 行の一部, why: 理由}]。理由の無いもの・もう当たらないものは赤
+  # 例（ci/devhost_allow.yaml）:
+  # - {path: apps/web/tests/_lib/fake-bridge.ts, contains: "127.0.0.1:3124", why: 試験の中で自分が立てる画面の口（相手ではない）}
+  # - {path: vitest.config.ts, contains: DEV_TEST_DATABASE_URL, why: CI（CI=true）では使わない手元だけの既定}
