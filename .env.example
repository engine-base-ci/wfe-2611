# 正本（G13 ci:env-audit が packages/config の読む名前と突き合わせる）。値は例。秘密は Infisical の環境から入れる（この例の値を本番で使わない）
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
# DB（関門 C2）。管理者の接続は migration だけに使う。実行時は kaname_app
DATABASE_URL=postgres://kaname_app:kaname_app@127.0.0.1:55433/kaname_test
# 認証（Better Auth・schema auth・境界 B2）
AUTH_DATABASE_URL=postgres://kaname_auth:kaname_auth@127.0.0.1:55433/kaname_test
AUTH_SECRET=change-me-32-chars-minimum-000000000000
# ストレージ（S3 互換 API だけ。supabase-js の storage クライアントは使わない）
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=ap-northeast-1
STORAGE_BUCKET=kaname-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
# 秘密（関門 C8）。base64 で 32 バイト以上
SECRETS_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# 通知（関門 C6・Resend）。無ければメールは送らない（inapp だけ）
RESEND_API_KEY=
